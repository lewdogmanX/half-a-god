      "talk": "minecraft:villager",
      "amount": 1,
      "mandatory": true,
      "stage": 0,
      "auto_advance": true,
      "say": {
        "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.goals.2.say",
        "fallback": "The messenger takes the stone and timber. Return to the villager who sent you and tell them the other village received the supplies."
      },
      "name": {
        "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.goals.2.name",
        "fallback": "Village Messenger"
      }
    },
    {
      "id": "return_to_original_villager",
      "return": true,
      "amount": 1,
      "mandatory": true,
      "stage": 1
    }
  ],
  "threat": {
    "entity": "minecraft:villager",
    "name": {
      "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.threat.name",
      "fallback": "Village Messenger"
    },
    "structure": "minecraft:villages",
    "search_radius": 4200,
    "spawn_radius": 10,
    "spawn_on_accept": true,
    "spare": false,
    "glow": false,
    "target_line": {
      "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.threat.target_line",
      "fallback": "You are from the first village? Good. If you have the stone and oak, hand them over before the well gives way."
    },
    "delivery_objectives": [
      "delivery_cobblestone",
      "delivery_oak_logs"
    ],
    "delivery_choice_label": {
      "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.threat.delivery_choice_label",
      "fallback": "Hand over supplies"
    },
    "delivered_line": {
      "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.threat.delivered_line",
      "fallback": "That will hold the well until our mason returns. Tell them the road between our villages is still worth keeping open."
    },
    "depart_after_delivery": false,
    "min_structure_distance": 700
  },
