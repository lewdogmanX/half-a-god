{
  "title": {
    "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.title",
    "fallback": "Stone and Timber for the Next Village"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.summary",
    "fallback": "Carry cobblestone and oak logs to a messenger waiting in another village."
  },
  "sequential_objectives": true,
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.dialogue.intro",
      "fallback": "A runner from the next village came through before dawn. Their well wall has split, and they need stone and timber before nightfall."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.dialogue.offer.0.0",
          "fallback": "What do they need?"
        },
        {
          "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.dialogue.offer.0.1",
          "fallback": "Plain materials, but quickly: cobblestone for the well ring and oak logs for the brace frame."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.dialogue.offer.1.0",
          "fallback": "Where do I take them?"
        },
        {
          "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.dialogue.offer.1.1",
          "fallback": "A village messenger is waiting away from here. Find the other village and give the supplies to them, not to me."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.dialogue.return",
      "fallback": "The messenger received the stone and timber? Then their well still stands, and so does the road between us."
    },
    "reward": {
      "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.dialogue.reward",
      "fallback": "You carried help farther than our own feet could manage today. Take this with our thanks."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.delivery_cobblestone_oak_log_other_village.dialogue.done",
      "fallback": "The other village sent word: their well is braced, and the road is open."
    }
  },
  "goals": [
    {
      "id": "delivery_cobblestone",
      "collect": "minecraft:cobblestone",
      "amount": 32,
      "mandatory": true,
      "stage": 0
    },
    {
      "id": "delivery_oak_logs",
