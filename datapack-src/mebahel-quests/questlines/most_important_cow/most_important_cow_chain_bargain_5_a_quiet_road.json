{
  "title": {
    "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.title",
    "fallback": "A Quiet Road"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.summary",
    "fallback": "You accepted the pillagers' bargain. Escort Tobyn and bring a cow to the old outpost, then discover what their promise of peace is really worth."
  },
  "requires": {
    "quests": [
      "mebahelrpgrquest:most_important_cow_chain_4_the_price_of_a_queen"
    ],
    "traits": [
      "buttercup_bargain_accepted"
    ]
  },
  "sequential_objectives": true,
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.intro",
      "fallback": "I am coming with you. If Buttercup is being traded for our lives, she will not walk that road with only a stranger beside her."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.offer.0.0",
          "fallback": "You don't have to come."
        },
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.offer.0.1",
          "fallback": "Mara walked toward danger alone once. I have spent years hating myself for letting that be the last thing she did. I will not repeat it with her cow."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.offer.1.0",
          "fallback": "The bargain could save both villages."
        },
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.offer.1.1",
          "fallback": "I know. That is what makes it a real bargain. If it were obviously evil, neither of us would feel sick."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.offer.2.0",
          "fallback": "Then we go together."
        },
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.offer.2.1",
          "fallback": "Together. And if Rath lied, I reserve the right to say I told you so while we are being shot at."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.return",
      "fallback": "They never meant to keep the road quiet. They meant to kill Buttercup, kill us, and call the silence a fulfilled contract."
    },
    "return_steps": [
      [
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.return_steps.0.0",
          "fallback": "I thought the bargain might save the villages."
        },
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.return_steps.0.1",
          "fallback": "So did Mara, once. She traded herself for a village and I spent years calling it brave because the other word hurt too much."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.return_steps.1.0",
          "fallback": "I came back for Buttercup."
        },
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.return_steps.1.1",
          "fallback": "You did. That is why I am angry instead of finished with you."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.return_steps.2.0",
          "fallback": "What happens now?"
        },
        {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.return_steps.2.1",
          "fallback": "Now Buttercup goes home, eats my flowers, breaks another fence, and receives no further diplomatic appointments."
        }
      ]
    ],
    "reward": {
      "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.reward",
      "fallback": "Take Mara's old bell. I kept it because I could not let go. I want you to carry it because I finally can."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.most_important_cow_chain_bargain_5_a_quiet_road.dialogue.done",
      "fallback": "Buttercup is not a queen. She is a cow. Mara's cow. Tonight, that is enough."
    }
  },
