      "amount": 1,
      "structure": "minecraft:mineshaft",
      "container": "minecraft:barrel",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_2_the_cow_has_spoken.goals.2.quest_book.title",
          "fallback": "Tunnel Route Ledger"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.most_important_cow_chain_2_the_cow_has_spoken.goals.2.quest_book.author",
          "fallback": "North Road Detail"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.most_important_cow_chain_2_the_cow_has_spoken.goals.2.quest_book.pages.0",
            "fallback": "Tunnel Four remains dry. Keep digging beneath the north road. No banners above ground."
          },
          {
            "translate": "quest.mebahelrpgrquest.most_important_cow_chain_2_the_cow_has_spoken.goals.2.quest_book.pages.1",
            "fallback": "The bell-cow still reacts to tar and horn leather. Keep scouts downwind until the village road is cut."
          },
          {
            "translate": "quest.mebahelrpgrquest.most_important_cow_chain_2_the_cow_has_spoken.goals.2.quest_book.pages.2",
            "fallback": "Old report attached: Mara Porridge trained the animal during the border years. If the cow remains alive, assume the road is being watched."
          },
          {
            "translate": "quest.mebahelrpgrquest.most_important_cow_chain_2_the_cow_has_spoken.goals.2.quest_book.pages.3",
            "fallback": "Three scouts remain below until the tunnel reaches the well line. Do not surface unless the bell-cow is gone."
          }
        ]
      },
      "stage": 2,
      "radius": 3200,
      "name": {
        "translate": "quest.mebahelrpgrquest.most_important_cow_chain_2_the_cow_has_spoken.goals.2.name",
        "fallback": "Tunnel Route Ledger"
