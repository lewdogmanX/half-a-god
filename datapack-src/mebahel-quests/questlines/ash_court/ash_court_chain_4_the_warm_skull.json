      "say": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_4_the_warm_skull.goals.2.say",
        "fallback": "The skull clicks once when the amethyst touches the table. That was not bone settling. That was an answer."
      }
    },
    {
      "id": "wait_for_the_skull",
      "type": "wait_time",
      "wait_until": "next_night",
      "stage": 1,
      "say": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_4_the_warm_skull.goals.3.say",
        "fallback": "At nightfall the skull warms without flame, and a line of black glass appears in its eye socket: a road, not a face."
      }
    },
