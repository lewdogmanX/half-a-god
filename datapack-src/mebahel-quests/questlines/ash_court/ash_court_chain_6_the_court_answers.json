{
  "title": {
    "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.title",
    "fallback": "The Court Answers"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.summary",
    "fallback": "Salvage the lost resonator core from a shipwreck, survive its drowned crew, build the tuned bell ward, and break the Ash Court's answer."
  },
  "flow": {
    "next": "mebahelrpgrquest:ash_court_chain_7_names_under_stone"
  },
  "requires": {
    "quests": [
      "mebahelrpgrquest:ash_court_chain_5_black_glass_road"
    ],
    "traits": [
      "ash_court_marker_recovered"
    ]
  },
  "sequential_objectives": true,
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.intro",
      "fallback": "The black-glass waystone has started opening for a heartbeat at sunset. Each time, ash falls beside the village bell."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.offer.0.0",
          "fallback": "The waystone is reopening."
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.offer.0.1",
          "fallback": "The Court is testing the old passage. We will force it to open only inside a ward, then kill whatever they send through."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.offer.1.0",
          "fallback": "You want to use the village as bait?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.offer.1.1",
          "fallback": "No. Bait waits and hopes. A tuned bell chooses what can cross. First we need its resonator core. I sent it by sea to keep it from greedy hands. The ship never reached port."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.offer.2.0",
          "fallback": "What do I have to do?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.offer.2.1",
          "fallback": "Find the wreck and recover its sealed core. But be ready: the last salvage crew heard bells beneath the water, then vanished. Bring the core back to me, and I will bind it inside crying obsidian for the ward."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.return",
      "fallback": "You came back without a trophy, which is exactly how I know the ward worked. The Court's answer broke before it could become a relic."
    },
    "return_steps": [
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.return_steps.0.0",
          "fallback": "Did we close the road?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.return_steps.0.1",
          "fallback": "This road, yes. The crying obsidian held the tuned core steady, the bell chose a single answer, and that answer died where everyone could see it."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.return_steps.1.0",
          "fallback": "Will they send more?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.return_steps.1.1",
          "fallback": "Courts do not forgive insult. But they count cost better than pride. Tonight, this village became expensive."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.return_steps.2.0",
          "fallback": "What happens now?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.return_steps.2.1",
          "fallback": "We leave no court-token for ambitious hands to polish. We keep the lesson instead: answer the road, break the voice, keep the village standing."
        }
      ]
    ],
    "reward": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.reward",
      "fallback": "You did more than kill monsters. You made the village answer intelligently: first with preparation, then with steel only when steel mattered."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.dialogue.done",
      "fallback": "The bell rings clean again. I still hear the old note underneath it, but now it belongs to us."
    }
  },
  "goals": [
    {
      "id": "recover_bell_resonator",
      "collect": "minecraft:amethyst_shard",
      "amount": 1,
      "in_chest": true,
