    {
      "id": "kill_wither_oathguards",
      "kill": "minecraft:wither_skeleton",
      "amount": 2,
      "stage": 3,
      "from_threats": true,
      "auto_advance": true,
      "say": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.goals.8.say",
        "fallback": "The second wave burns out. The bell steadies, the black-glass note breaks, and the village is quiet enough to hear your own breath. Return to the villager."
      }
    }
  ],
