      "range": 70,
      "auto_advance": true,
      "stage": 1,
      "say": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.goals.3.say",
        "fallback": "The tuned resonator wakes between the three obsidian braces and three soul lanterns. The bell rings once by itself, every flame in the village burns blue, and the first dead step through the note."
      }
    },
    {
