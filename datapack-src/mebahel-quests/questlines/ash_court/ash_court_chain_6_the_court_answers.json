      "stage": 2,
      "from_threats": true,
      "auto_advance": true,
      "say": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_6_the_court_answers.goals.5.say",
        "fallback": "The first answer collapses into ash. The bell does not quiet. Something above the note has heard you."
      }
    },
