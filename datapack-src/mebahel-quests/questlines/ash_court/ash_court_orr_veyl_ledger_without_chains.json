        "chest": {
          "item": "minecraft:iron_chestplate",
          "enchants": {
            "minecraft:protection": 3
          }
        }
      },
      "offer_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.offer_line",
        "fallback": "Orr Veyl waits among broken record chains. He has no guards left and no master to return to."
      },
      "target_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.target_line",
        "fallback": "I numbered the delivered and called it duty. You let me leave. I used that mercy to keep these names from burning."
      },
      "talk": [
        [
          {
            "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.talk.0.0",
            "fallback": "Why not bring the book yourself?"
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.talk.0.1",
            "fallback": "Because the village should not have to watch me cross its road before it chooses what I am worth. I left proof first. Judgment can follow."
          }
        ],
        [
          {
            "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.talk.1.0",
            "fallback": "What do you want now?"
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.talk.1.1",
            "fallback": "A road with no ledger at the end of it. A blade pointed at collectors, not prisoners. Orders I can refuse when they stink of chains."
          }
        ],
        [
          {
            "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.talk.2.0",
            "fallback": "Can the village trust you?"
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.talk.2.1",
            "fallback": "No. Trust is too clean a word. Let me earn usefulness before anyone spends forgiveness on me."
          }
        ]
      ],
      "attack_choice_label": {
        "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.attack_choice_label",
        "fallback": "Some records end in blood."
      },
      "spare_choice_label": {
        "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.spare_choice_label",
        "fallback": "Then walk with me and guard the living names."
      },
      "attack_return_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.attack_return_line",
        "fallback": "Orr accepts the sentence without surprise and raises his sword one final time."
      },
      "spared_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.spared_line",
        "fallback": "Orr breaks the last chain from his ledger and kneels beside the rescued names."
      },
      "post_spare_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.post_spare_line",
        "fallback": "No more deliveries. No more numbered dead. If you call, I will answer as Orr Veyl, not as the Court's keeper."
      },
      "villager_spared_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.villager_spared_line",
        "fallback": "You returned with the names and Orr's oath. The village will not forgive quickly, but perhaps that is exactly why he should keep walking beside someone who remembers."
      },
      "rewards_from_giver": true,
