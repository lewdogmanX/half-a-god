      "name": {
        "translate": "quest.mebahelrpgrquest.ash_court_orr_veyl_ledger_without_chains.threats.6.name",
        "fallback": "Orr Veyl, Unbound Archivist"
      },
      "stage": 5,
      "spawn_origin": "player",
      "spawn_min_radius": 4,
      "spawn_max_radius": 10,
      "spawn_on_accept": true,
      "spare": true,
