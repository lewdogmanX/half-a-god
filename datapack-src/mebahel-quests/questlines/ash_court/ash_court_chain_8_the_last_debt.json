      "head": "minecraft:wither_skeleton_skull",
      "chest": {
        "item": "minecraft:netherite_chestplate",
        "enchants": {
          "minecraft:protection": 3
        }
      }
    },
    "offer_line": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.offer_line",
      "fallback": "Avar Khel enters through the old collection gate carrying the keys to the cells where the surviving prisoners are held."
    },
    "target_line": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.target_line",
      "fallback": "Your founders brought me criminals, raiders, and strangers. In return, I stopped a plague and guarded their children for six generations. Do not pretend the bargain had only one beneficiary."
    },
    "talk": [
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.talk.0.0",
          "fallback": "Release every surviving prisoner."
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.talk.0.1",
          "fallback": "I will, if the village either surrenders my ward or pays for it honestly. Protection has a cost even when heroes dislike the invoice."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.talk.1.0",
          "fallback": "You murdered travelers for a bargain."
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.talk.1.1",
          "fallback": "Your founders chose them, chained them, and rang the bell. I received what your village delivered. Judge me—but do not clean their hands to dirty mine."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.talk.2.0",
          "fallback": "What bargain are you offering now?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.talk.2.1",
          "fallback": "One chest of gold each winter, iron for my guards, and open trade through the Nether road. No prisoners. Refuse, and my ward ends tonight."
        }
      ]
    ],
    "attack_choice_label": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.attack_choice_label",
      "fallback": "Release the prisoners. The village will survive without your ward."
    },
    "spare_choice_label": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.spare_choice_label",
      "fallback": "Accept gold and iron—and triumph over your final trial."
    },
