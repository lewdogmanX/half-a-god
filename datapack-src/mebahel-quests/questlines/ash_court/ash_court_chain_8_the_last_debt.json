    "attack_return_line": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.attack_return_line",
      "fallback": "Avar Khel falls and the prison keys strike the floor. The ward around the distant village goes dark, but the surviving captives are free."
    },
    "spared_line": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.spared_line",
      "fallback": "You permit the Crownless Cinder to approach the chained ledger."
    },
    "post_spare_line": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.post_spare_line",
      "fallback": "Avar Khel signs the amended ledger, opens the cells, and surrenders the waystone keys. The village keeps the ward and assumes a costly annual tribute."
    },
    "villager_spared_line": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.threat.villager_spared_line",
      "fallback": "The prisoners are free. We kept the ward, but every winter the village will see exactly what its protection costs—and pay it from its own stores."
    },
