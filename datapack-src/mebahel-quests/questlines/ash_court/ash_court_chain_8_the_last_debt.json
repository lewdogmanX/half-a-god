{
  "title": {
    "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.title",
    "fallback": "The Last Debt"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.summary",
    "fallback": "Escort the ledger-bearer to the Hall Beneath the Eye, open the old passage, confront Avar Khel, and decide whether to destroy or renegotiate the village's protection."
  },
  "requires": {
    "quests": [
      "mebahelrpgrquest:ash_court_chain_7_names_under_stone"
    ],
    "traits": [
      "ash_court_first_debt_known"
    ]
  },
  "sequential_objectives": true,
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.intro",
      "fallback": "The villager carries the founders' ledger and Selka's wooden horse. Twelve people were delivered through the waystone. Orr Veyl's record says at least five remain imprisoned in the Hall Beneath the Eye."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.offer.0.0",
          "fallback": "You are coming with me?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.offer.0.1",
          "fallback": "The agreement requires a village representative. I will renounce it before Avar Khel and testify that the deliveries were crimes, not lawful payment."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.offer.1.0",
          "fallback": "What waits in the hall?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.offer.1.1",
          "fallback": "Avar Khel, the Crownless Cinder. He supplied the plague medicine, commanded the undead sentries, and received every prisoner delivered through the waystone."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.offer.2.0",
          "fallback": "What if it offers another bargain?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.offer.2.1",
          "fallback": "Then hear the exact terms. Destroy him and the ward dies with him. Spare him only if he releases every surviving prisoner and accepts goods instead of people."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.offer.3.0",
          "fallback": "How do we survive the meeting?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.offer.3.1",
          "fallback": "Guide me through the Nether road to the fortress and anchor the old passage with crying obsidian and soul fire. When Avar Khel arrives, keep your weapon lowered until we hear his terms."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.return",
      "fallback": "The collection route is closed and the surviving prisoners are free. Whatever agreement remains, people are no longer its currency."
    },
    "return_steps": [
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.return_steps.0.0",
          "fallback": "The protection is gone."
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.return_steps.0.1",
          "fallback": "Then we will protect one another without feeding strangers to the dark. Safety bought that way was only danger wearing our walls."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.return_steps.1.0",
          "fallback": "What happens to the survivors?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.return_steps.1.1",
          "fallback": "Those with homes may return to them. Those without one will be offered beds here, if they can bear the sight of our bell."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.return_steps.2.0",
          "fallback": "Was killing it the right choice?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.return_steps.2.1",
          "fallback": "It was a final choice. Do not confuse finality with purity. We will learn its cost together."
        }
      ]
    ],
    "return_steps_on_spare": [
      [
        {
          "translate": "dialogue.mebahelrpgrquest.ash_court_last_debt_spare.protection.choice",
          "fallback": "The protection remains?"
        },
        {
          "translate": "dialogue.mebahelrpgrquest.ash_court_last_debt_spare.protection.line",
          "fallback": "Yes. Avar Khel accepted gold, iron, and open trade instead of prisoners. The ward remains, but no living person will ever be payment again."
        }
      ],
      [
        {
          "translate": "dialogue.mebahelrpgrquest.ash_court_last_debt_spare.prisoners.choice",
          "fallback": "What happens to the prisoners?"
        },
        {
          "translate": "dialogue.mebahelrpgrquest.ash_court_last_debt_spare.prisoners.line",
          "fallback": "Every surviving prisoner was released before the amended ledger was sealed. Those with homes may return; the others will be offered shelter here."
        }
      ],
      [
        {
          "translate": "dialogue.mebahelrpgrquest.ash_court_last_debt_spare.examiners.choice",
          "fallback": "Why did he send the examiners?"
        },
        {
          "translate": "dialogue.mebahelrpgrquest.ash_court_last_debt_spare.examiners.line",
          "fallback": "He called it a final audit: proof that our new agreement was accepted by strength, not fear. You survived it, and now even the Court must honor the written terms."
        }
      ]
    ],
    "reward": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.reward",
      "fallback": "The founders left us shelter built from cowardice. You leave us an uncertain future that is finally ours."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_8_the_last_debt.dialogue.done",
      "fallback": "The bell has lost its hidden note. It sounds smaller now—and honest."
    }
  },
