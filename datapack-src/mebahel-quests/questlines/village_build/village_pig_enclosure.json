{
  "title": {
    "translate": "quest.mebahelrpgrquest.village_pig_enclosure.title",
    "fallback": "A Pen for the First Herd"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.village_pig_enclosure.summary",
    "fallback": "Help me raise that first pen and bring two pigs safely inside it. If you do, I will see that you are rewarded not as a hired hand, but as a friend of this village."
  },
  "sequential_objectives": true,
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.intro",
      "fallback": "Stranger, have you a moment? I have been staring at this empty patch of earth all morning, wondering whether it might become the start of something better."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.offer.0.0",
          "fallback": "You look worried. What happened?"
        },
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.offer.0.1",
          "fallback": "Worried? No. Hungry, perhaps. The village lives from one harvest to the next, and a bad storm could empty every bowl we own."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.offer.1.0",
          "fallback": "You want to start an animal pen?"
        },
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.offer.1.1",
          "fallback": "Aye. Not a grand farm, not yet. Just enough fence, a gate, light for the night, and two pigs to make the place feel alive."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.offer.2.0",
          "fallback": "Why ask me?"
        },
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.offer.2.1",
          "fallback": "Because people here know how to survive, but few know how to begin. Help me build the first enclosure, and the village will remember who gave it roots."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.offer.3.0",
          "fallback": "Tell me exactly what you need."
        },
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.offer.3.1",
          "fallback": "Place thirteen oak fences, one oak fence gate, and two torches within fifty blocks of me. Then bring two new pigs into the pen."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.return",
      "fallback": "The raiders are gone? Then the pen still stands because of you. First we built walls for animals; tonight, you were the wall for all of us."
    },
    "return_steps": [
      [
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.return_steps.0.0",
          "fallback": "They came straight for the pen."
        },
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.return_steps.0.1",
          "fallback": "Of course they did. Raiders can smell a village trying to become stronger. They wanted to break the idea before it became food."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.return_steps.1.0",
          "fallback": "The pigs are safe."
        },
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.return_steps.1.1",
          "fallback": "Then the village is safer than it was this morning. Not rich. Not fearless. But safer, and that matters."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.return_steps.2.0",
          "fallback": "What happens now?"
        },
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.return_steps.2.1",
          "fallback": "Now we breed the herd, mend the fence, and teach everyone here that building something is worth defending."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.return_steps.3.0",
          "fallback": "That blade by your side. Whose was it?"
        },
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.return_steps.3.1",
          "fallback": "An old herdsman's. He used it to drive wolves from the pens. It has guarded empty fields for too long."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.return_steps.4.0",
          "fallback": "Then why give it to me?"
        },
        {
          "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.return_steps.4.1",
          "fallback": "Because you stood before the raiders when they came with axes. A fence is only as strong as the soul willing to stand before it."
        }
      ]
    ],
    "reward": {
      "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.reward",
      "fallback": "Take it. Tonight, it belongs in your hands."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.village_pig_enclosure.dialogue.done",
      "fallback": "The pigs are settling in. Every grunt from that pen sounds like tomorrow arriving."
    }
  },
  "goals": [
    {
