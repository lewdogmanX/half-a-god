      "amount": 13,
      "stage": 0,
      "range": 70,
      "say": {
        "translate": "quest.mebahelrpgrquest.village_pig_enclosure.goals.0.say",
        "fallback": "That pen stands like a promise. I can already hear the village children arguing over what to name the pigs. Stay close, though. Fresh food draws hungry eyes, and I do not like the dust rising beyond the fields."
      }
    },
