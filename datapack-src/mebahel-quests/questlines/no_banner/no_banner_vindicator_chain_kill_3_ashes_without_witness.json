{
  "title": {
    "translate": "quest.mebahelrpgrquest.no_banner_vindicator_chain_kill_3_ashes_without_witness.title",
    "fallback": "Ashes Without a Witness"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.no_banner_vindicator_chain_kill_3_ashes_without_witness.summary",
    "fallback": "Rurik is dead, but his warning may still have been true. Search the outpost for the prison keys and end the raiders guarding them."
  },
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.no_banner_vindicator_chain_kill_3_ashes_without_witness.dialogue.intro",
      "fallback": "A dead raider cannot lie, but neither can he explain himself. We are left with ash, doubt, and a road still leading to the outpost."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.no_banner_vindicator_chain_kill_3_ashes_without_witness.dialogue.offer.0.0",
          "fallback": "You still believe there are captives?"
        },
        {
          "translate": "quest.mebahelrpgrquest.no_banner_vindicator_chain_kill_3_ashes_without_witness.dialogue.offer.0.1",
          "fallback": "I believe fear makes fools of everyone. If captives are there and we ignore them because we hated the messenger, their chains are partly ours."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.no_banner_vindicator_chain_kill_3_ashes_without_witness.dialogue.offer.1.0",
          "fallback": "What should I do?"
        },
        {
          "translate": "quest.mebahelrpgrquest.no_banner_vindicator_chain_kill_3_ashes_without_witness.dialogue.offer.1.1",
          "fallback": "Search the outpost. Kill the guards who keep the lower rooms, and bring back any keys or ledgers you find. Let the dead raider be wrong, if mercy allows it."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.no_banner_vindicator_chain_kill_3_ashes_without_witness.dialogue.return",
      "fallback": "Keys and names. Then the raider told the truth, and we killed the only man who tried to carry it back."
    },
    "reward": {
      "translate": "quest.mebahelrpgrquest.no_banner_vindicator_chain_kill_3_ashes_without_witness.dialogue.reward",
      "fallback": "Take this, but understand what it is: payment for captives saved too late to thank the witness who named them. The village will remember both the rescue and the cost of silence."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.no_banner_vindicator_chain_kill_3_ashes_without_witness.dialogue.done",
      "fallback": "The captives are free, but there is an empty place beside the shrine where a harder ending might have stood."
    }
  },
