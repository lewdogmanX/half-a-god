        "fallback": "Black-Thread Token"
      },
      "tag": "quiet_ledger_contract",
      "in_chest": true
    },
    {
      "id": "recover_contract_scraps",
      "collect": "minecraft:paper",
      "amount": 2,
      "structure": "minecraft:village_plains",
      "radius": 2500,
      "name": {
        "translate": "quest.mebahelrpgrquest.village_defense_chain_4_the_road_remembers.goals.1.name",
        "fallback": "Torn Assassin Contract"
      },
      "tag": "quiet_ledger_contract",
      "in_chest": true
    }
  ],
  "rewards": {
    "xp": 320,
    "items": {
