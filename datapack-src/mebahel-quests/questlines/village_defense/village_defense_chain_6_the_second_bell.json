{
  "title": {
    "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.title",
    "fallback": "The Ledger Must Burn"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.summary",
    "fallback": "Strike the Quiet Ledger's counting room and kill the assassin-master who paid to turn your reputation into a corpse."
  },
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.intro",
      "fallback": "The villager has stopped whispering. Fear is still there, but now it has a direction."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.offer.0.0",
          "fallback": "Who leads them?"
        },
        {
          "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.offer.0.1",
          "fallback": "A man named Sable Varr. Not a raider, not a soldier. A buyer of endings. He believes villages stay obedient when their heroes die early."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.offer.1.0",
          "fallback": "Why me?"
        },
        {
          "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.offer.1.1",
          "fallback": "Because you proved a bell can be answered. If that story spreads, every frightened village starts looking at its own hands and wondering what they can hold."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.offer.2.0",
          "fallback": "Then the Ledger burns."
        },
        {
          "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.offer.2.1",
          "fallback": "Burn the ledger, kill Varr, and leave enough ashes that every paid knife knows the price for hunting hope has gone up."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.return",
      "fallback": "Sable Varr is dead? Then tonight the road carries a different rumor."
    },
    "return_steps": [
      [
        {
          "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.return_steps.0.0",
          "fallback": "The ledger is gone."
        },
        {
          "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.return_steps.0.1",
          "fallback": "Then those names are people again, not prices."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.return_steps.1.0",
          "fallback": "They wanted the story dead."
        },
        {
          "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.return_steps.1.1",
          "fallback": "Then let the story answer properly: the one who held the bell lived, and the men who bought his grave did not."
        }
      ]
    ],
    "reward": {
      "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.reward",
      "fallback": "This is from everyone whose name was written in that book. They may never know how close the knife came, but they will live loudly enough to repay you."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.village_defense_chain_6_the_second_bell.dialogue.done",
      "fallback": "The Quiet Ledger is ash. Some contracts deserve no archive."
    }
  },
