{
  "title": {
    "translate": "quest.mebahelrpgrquest.false_hero_chain_kill_3_convenient_silence.title",
    "fallback": "Convenient Silence"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.false_hero_chain_kill_3_convenient_silence.summary",
    "fallback": "The witness is dead, and raiders are cleaning up the outpost road. Stop them before the lie becomes permanent."
  },
  "requires": {
    "quests": [
      "mebahelrpgrquest:false_hero_chain_2_the_last_witness"
    ],
    "traits": [
      "false_hero_witness_killed"
    ]
  },
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.false_hero_chain_kill_3_convenient_silence.dialogue.intro",
      "fallback": "The village is celebrating the champion again. I hear their cheers from here, and every cheer sounds like a shovel striking dirt."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.false_hero_chain_kill_3_convenient_silence.dialogue.offer.0.0",
          "fallback": "You still think he lied?"
        },
        {
          "translate": "quest.mebahelrpgrquest.false_hero_chain_kill_3_convenient_silence.dialogue.offer.0.1",
          "fallback": "I think dead witnesses make liars comfortable. Raiders are gathering where the trail began. That means someone is cleaning up loose ends."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.false_hero_chain_kill_3_convenient_silence.dialogue.offer.1.0",
          "fallback": "What do you want done?"
        },
        {
          "translate": "quest.mebahelrpgrquest.false_hero_chain_kill_3_convenient_silence.dialogue.offer.1.1",
          "fallback": "End the cleanup. Kill the raiders still holding the outpost road. We may not get the truth, but we can at least stop more blood from being buried under it."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.false_hero_chain_kill_3_convenient_silence.dialogue.return",
      "fallback": "The outpost road is quiet, then. Quiet is not the same as clean, but it is all we have left."
    },
    "reward": {
      "translate": "quest.mebahelrpgrquest.false_hero_chain_kill_3_convenient_silence.dialogue.reward",
      "fallback": "Take this from the village stores. You ended the raiders who came to bury the trail. As for the champion, he has left before dawn. Heroes rarely flee their own songs."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.false_hero_chain_kill_3_convenient_silence.dialogue.done",
      "fallback": "The champion is gone, the witness is dead, and the village has learned to cheer more carefully."
    }
  },
