        "head": "minecraft:leather_helmet"
      },
      "drop_on_death": [
        {
          "type": "item",
          "item": "minecraft:written_book",
          "count": 1,
          "name": {
            "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.drop_on_death.0.name",
            "fallback": "Final Funeral Accounting"
          },
          "tag": "garrick_bell_final_account",
          "quest_book": {
            "title": {
              "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.drop_on_death.0.quest_book.title",
              "fallback": "Final Funeral Accounting"
            },
            "author": {
              "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.drop_on_death.0.quest_book.author",
              "fallback": "Garrick Bell"
            },
            "pages": [
              {
                "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.drop_on_death.0.quest_book.pages.0",
                "fallback": "FINAL FUNERAL ACCOUNTING\n\nCorwin Bell: deceased.\n\nCause of death: excessive confidence in his own interpretation of written instructions."
              },
              {
                "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.drop_on_death.0.quest_book.pages.1",
                "fallback": "For the record, I warned him about the bell.\n\nI warned him about the coffin.\n\nI warned him about improvisation.\n\nHe considered all three warnings suggestions."
              },
              {
                "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.drop_on_death.0.quest_book.pages.2",
                "fallback": "You, meanwhile, have now conducted more successful Bell family funerals than any actual member of the Bell family.\n\nThis is not praise. It is an indictment."
              },
              {
                "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.drop_on_death.0.quest_book.pages.3",
                "fallback": "I have therefore amended the family rules.\n\nRule One: no bells.\nRule Two: no experimental burials.\nRule Three: nobody named Corwin is permitted to organize anything."
              },
              {
                "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.drop_on_death.0.quest_book.pages.4",
                "fallback": "One final confession: the egg from my first funeral was never part of the ritual.\n\nI simply owed a farmer an egg and did not want to die with an outstanding debt."
              },
              {
                "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.drop_on_death.0.quest_book.pages.5",
                "fallback": "My estate has been instructed to compensate you for candles, travel, undead relatives, and emotional inconvenience."
              },
              {
                "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.drop_on_death.0.quest_book.pages.6",
                "fallback": "As for me, I intend to remain dead.\n\nShould this arrangement fail again, I will be filing a formal complaint with Death."
              },
              {
                "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.drop_on_death.0.quest_book.pages.7",
                "fallback": "There will be no fourth funeral.\n\nThere may, regrettably, be correspondence."
              }
            ]
          }
        }
      ]
    },
    {
      "entity": "minecraft:skeleton",
      "name": {
        "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.1.name",
        "fallback": "Uninvited Pallbearer"
