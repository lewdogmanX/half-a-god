{
  "title": {
    "translate": "quest.mebahelrpgrquest.garrick_third_funeral.title",
    "fallback": "Instructions for My Third Funeral"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.garrick_third_funeral.summary",
    "fallback": "Garrick's third volume contains an unexpected correction: the next funeral belongs to Corwin, whose attempt to improve the family ritual has gone badly."
  },
  "sequential_objectives": true,
  "goals": [
    {
      "id": "find_corwins_improved_funeral",
      "reach": "minecraft:village_plains",
      "radius": 5000,
      "range": 80,
      "stage": 0,
      "auto_advance": true
    },
    {
      "id": "read_corwins_procedure",
      "type": "read_book",
      "item": "minecraft:written_book",
      "amount": 1,
      "structure": "minecraft:village_plains",
      "radius": 5000,
      "stage": 1,
      "in_chest": true,
      "container": "minecraft:barrel",
      "name": {
        "translate": "quest.mebahelrpgrquest.garrick_third_funeral.goals.1.name",
        "fallback": "Corwin Bell's Improved Funeral Procedure"
      },
      "tag": "corwin_bell_improved_funeral",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.garrick_third_funeral.goals.1.quest_book.title",
          "fallback": "Improved Funeral Procedure"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.garrick_third_funeral.goals.1.quest_book.author",
          "fallback": "Corwin Bell"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.garrick_third_funeral.goals.1.quest_book.pages.0",
            "fallback": "Uncle Garrick's problem is obvious: everyone keeps following his instructions instead of improving them."
          },
          {
            "translate": "quest.mebahelrpgrquest.garrick_third_funeral.goals.1.quest_book.pages.1",
            "fallback": "He says never ring the family bell three times. I have therefore rung it four times. This is called careful interpretation."
          },
          {
            "translate": "quest.mebahelrpgrquest.garrick_third_funeral.goals.1.quest_book.pages.2",
            "fallback": "He says the dead should remain lying down. I have placed the coffin upright so gravity can assist."
          },
          {
            "translate": "quest.mebahelrpgrquest.garrick_third_funeral.goals.1.quest_book.pages.3",
            "fallback": "The villagers have asked me to stop. This is the sort of resistance every innovator faces."
          },
          {
            "translate": "quest.mebahelrpgrquest.garrick_third_funeral.goals.1.quest_book.pages.4",
            "fallback": "If this works, Garrick will finally remain dead. If it does not, I will revise the procedure personally."
          }
        ]
      },
      "auto_advance": true
    },
    {
      "id": "wait_for_corwins_demonstration",
      "type": "wait_time",
      "wait_until": "next_night",
      "stage": 2,
      "auto_advance": true
    },
    {
      "id": "put_corwin_to_rest",
      "kill": "minecraft:zombie",
      "amount": 1,
      "stage": 3,
      "from_threats": true
    },
    {
      "id": "dismiss_the_pallbearers",
      "kill": "minecraft:skeleton",
      "amount": 2,
      "stage": 3,
      "from_threats": true,
      "auto_advance": true
    },
    {
      "id": "read_garricks_final_account",
      "type": "read_book",
      "item": "minecraft:written_book",
      "amount": 1,
      "stage": 4,
      "name": {
        "translate": "quest.mebahelrpgrquest.garrick_third_funeral.goals.5.name",
        "fallback": "Final Funeral Accounting"
      },
      "tag": "garrick_bell_final_account"
    }
  ],
  "threats": [
    {
      "entity": "minecraft:zombie",
      "name": {
        "translate": "quest.mebahelrpgrquest.garrick_third_funeral.threats.0.name",
        "fallback": "Corwin Bell, First-Time Deceased"
      },
      "stage": 3,
      "spawn_origin": "quest_target",
