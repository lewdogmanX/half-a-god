  "threat": {
    "entity": "minecraft:zombie",
    "name": {
      "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.name",
      "fallback": "Garrick Bell, Still Filing an Appeal"
    },
    "stage": 4,
    "spawn_origin": "quest_target",
    "spawn_min_radius": 3,
    "spawn_max_radius": 7,
    "spawn_on_accept": true,
    "spare": true,
    "glow": false,
    "max_health": 175,
    "equipment": {
      "mainhand": "minecraft:air",
      "head": "minecraft:golden_helmet",
      "chest": "minecraft:chainmail_chestplate"
    },
    "target_line": {
      "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.target_line",
      "fallback": "Before you swing that sword: Paragraph Seventeen. Please."
    },
    "talk": [
      [
        {
          "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.talk.0.0",
          "fallback": "You stood up again."
        },
        {
          "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.talk.0.1",
          "fallback": "Yes. You will be pleased to learn that standing is still not an act of aggression."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.talk.1.0",
          "fallback": "Why do you keep coming back?"
        },
        {
          "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.talk.1.1",
          "fallback": "If I knew, it would already be Paragraph One. The Bell family has had difficulty staying buried for three generations."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.talk.2.0",
          "fallback": "And the missing paragraph?"
        },
        {
          "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.talk.2.1",
          "fallback": "Corwin copied sixteen, became distracted, and continued at eighteen. I have considered haunting him on principle."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.talk.3.0",
          "fallback": "So what happens now?"
        },
        {
          "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.talk.3.1",
          "fallback": "You let me finish a sentence. Then I give you the third volume, because Corwin has managed to make this situation worse."
        }
      ]
    ],
    "attack_choice_label": {
      "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.attack_choice_label",
      "fallback": "I am not risking a fourth resurrection."
    },
    "spare_choice_label": {
      "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spare_choice_label",
      "fallback": "Fine. Finish the sentence."
    },
    "spared_line": {
      "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spared_line",
      "fallback": "Thank you. This is already the most successful funeral I have attended."
    },
    "post_spare_line": {
      "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.post_spare_line",
      "fallback": "Take the third volume. The good news is that the next funeral is not mine."
    },
    "spare_handoff": {
      "item": "minecraft:written_book",
      "count": 1,
      "name": {
        "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spare_handoff.name",
        "fallback": "Instructions for My Third Funeral"
      },
      "depart_after_spare": true,
      "consume_on_claim": false,
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spare_handoff.quest_book.title",
          "fallback": "My Third Funeral Instructions"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spare_handoff.quest_book.author",
          "fallback": "Garrick Bell"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spare_handoff.quest_book.pages.0",
            "fallback": "THIRD FUNERAL. IMPORTANT CORRECTION: the title is now misleading. This funeral is not mine."
          },
          {
            "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spare_handoff.quest_book.pages.1",
            "fallback": "Corwin has taken the family bell. He says he intends to prove that my repeated deaths are caused by poor burial technique rather than anything supernatural."
          },
          {
            "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spare_handoff.quest_book.pages.2",
            "fallback": "His experimental procedure includes ringing the bell four times because I explicitly wrote never to ring it three times."
          },
          {
            "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spare_handoff.quest_book.pages.3",
            "fallback": "He has gone to a village to perform what he calls a Final Improved Funeral. He is not qualified to improve funerals."
          },
          {
            "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spare_handoff.quest_book.pages.4",
            "fallback": "Find Corwin. If he is alive, stop him. If he is dead, I regret to say that you already know the procedure better than he did."
          },
          {
            "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spare_handoff.quest_book.pages.5",
            "fallback": "Do not let him improvise. I have written this sentence in capital letters in the original manuscript."
          },
          {
            "translate": "quest.mebahelrpgrquest.garrick_second_funeral.threat.spare_handoff.quest_book.pages.6",
            "fallback": "There will NOT be a fourth funeral. If a fourth volume bearing my name appears, burn it unopened."
          }
        ]
      }
    },
