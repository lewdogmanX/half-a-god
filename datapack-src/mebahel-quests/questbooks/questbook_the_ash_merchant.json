  "quest_book": {
    "title": {
      "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.quest_book.title",
      "fallback": "The Ash Merchant"
    },
    "author": {
      "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.quest_book.author",
      "fallback": "Silas Dorn"
    },
    "color": "brown",
    "pages": [
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.quest_book.pages.0",
        "fallback": "ACCOUNT BOOK - SILAS DORN\n\nQuartz, blaze powder, iron, leather, food. Standard exchange rates recorded on the following pages."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.quest_book.pages.1",
        "fallback": "The first pages are ordinary enough. Then names begin appearing between the goods."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.quest_book.pages.2",
        "fallback": "Mira Vale - 12 gold.\nTomas Reed - 19 gold.\nJeren Holt - 9 gold.\n\nI told myself they were debts."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.quest_book.pages.3",
        "fallback": "There are more names after that. Beside each one, a price."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.quest_book.pages.4",
        "fallback": "If this book reaches the Overworld, follow the ruined portal marked with three cuts in the obsidian. The road beyond leads toward the bastion where the accounts are kept."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.quest_book.pages.5",
        "fallback": "Do not assume the person holding a ledger is the one making the sales."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.quest_book.pages.6",
        "fallback": "In places like this, even a prisoner may be useful enough to be given a pen."
      }
    ],
    "auto_claim_rewards": true
  }
}
