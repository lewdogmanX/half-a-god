      "range": 64,
      "stage": 0,
      "auto_advance": true
    },
    {
      "id": "enter_the_trade_road",
      "type": "enter_nether",
      "stage": 1,
      "auto_advance": true
    },
    {
      "id": "find_the_bastion_market",
      "reach": "minecraft:bastion_remnant",
      "radius": 7000,
      "range": 96,
      "stage": 2,
      "auto_advance": true
    },
    {
      "id": "read_silas_account_book",
      "type": "read_book",
      "item": "minecraft:written_book",
      "amount": 1,
      "structure": "minecraft:bastion_remnant",
      "radius": 7000,
      "stage": 3,
      "in_chest": true,
      "container": "minecraft:chest",
      "name": {
        "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.3.name",
        "fallback": "Silas Dorn's Account Book"
      },
      "tag": "silas_dorn_account_book",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.3.quest_book.title",
          "fallback": "Accounts in Ash"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.3.quest_book.author",
          "fallback": "Silas Dorn"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.3.quest_book.pages.0",
            "fallback": "Mira Vale - 12 gold.\nTomas Reed - 19 gold.\nJeren Holt - 9 gold.\nUnnamed child - 6 gold.\n\nAll marked RECEIVED."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.3.quest_book.pages.1",
            "fallback": "The handwriting changes here.\n\n'Not sold. Bought back.'"
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.3.quest_book.pages.2",
            "fallback": "I kept the prices because forgetting them felt worse. Every name is someone taken through the portal. Every payment is what I gathered to bring one home."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.3.quest_book.pages.3",
            "fallback": "The bastion clerks call me merchant because I count well. Let them. A prisoner who can count is still a prisoner."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.3.quest_book.pages.4",
            "fallback": "My own price is forty-eight gold.\n\nI have forty-seven."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.3.quest_book.pages.5",
            "fallback": "If someone from the Overworld finds this, do not waste your life carrying forty-eight gold into this place.\n\nJust make sure the book leaves with you."
          }
        ]
      },
      "auto_advance": true
    },
    {
      "id": "kill_the_collection_officer",
      "kill": "minecraft:piglin_brute",
      "amount": 1,
      "stage": 4,
      "from_threats": true
    },
    {
      "id": "kill_the_bastion_collectors",
      "kill": "minecraft:piglin",
      "amount": 3,
      "stage": 4,
      "from_threats": true,
      "auto_advance": true
    },
    {
      "id": "read_silas_final_entry",
      "type": "read_book",
      "item": "minecraft:written_book",
      "amount": 1,
      "structure": "minecraft:bastion_remnant",
      "radius": 7000,
      "stage": 5,
      "in_chest": true,
      "container": "minecraft:barrel",
      "name": {
        "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.6.name",
        "fallback": "Silas's Final Entry"
      },
      "tag": "silas_dorn_final_entry",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.6.quest_book.title",
          "fallback": "The Forty-Eighth Ingot"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.6.quest_book.author",
          "fallback": "Silas Dorn"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.6.quest_book.pages.0",
            "fallback": "I found the last ingot."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.6.quest_book.pages.1",
            "fallback": "One of the guards dropped it beside the furnace and never noticed."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.6.quest_book.pages.2",
            "fallback": "I held forty-eight gold in my hands for perhaps ten breaths."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.6.quest_book.pages.3",
            "fallback": "Then they brought in a girl from the Overworld. Her price was one."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.6.quest_book.pages.4",
            "fallback": "I bought her instead."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.goals.6.quest_book.pages.5",
            "fallback": "My balance is forty-seven again.\n\nI think I can live with that.\n\nI hope she can too."
          }
        ]
      }
    }
  ],
