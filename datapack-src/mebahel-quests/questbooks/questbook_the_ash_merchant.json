    "fallback": "The Ash Merchant"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.questbook_the_ash_merchant.summary",
    "fallback": "Follow the account book of Silas Dorn into the Nether and learn what the prices beside those human names really meant."
  },
  "sequential_objectives": true,
  "goals": [
    {
      "id": "find_silas_portal",
      "reach": "minecraft:ruined_portal",
