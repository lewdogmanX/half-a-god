      "head": "minecraft:leather_helmet",
      "chest": "minecraft:leather_chestplate"
    },
    "target_line": {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.target_line","fallback":"You are late."},
    "talk": [
      [
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.0.0","fallback":"For what?"},
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.0.1","fallback":"Dinner."}
      ],
      [
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.1.0","fallback":"Everyone here is dead."},
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.1.1","fallback":"That has not historically stopped attendance."}
      ],
      [
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.2.0","fallback":"Are you Merrin?"},
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.2.1","fallback":"Merrin, steward of Blackthorn House. I would offer to take your coat, but experience suggests travelers object when skeletons reach for them."}
      ],
      [
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.3.0","fallback":"Why is the thirteenth place still set?"},
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.3.1","fallback":"The Master ordered it kept for the final guest."}
      ],
      [
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.4.0","fallback":"Who is the final guest?"},
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.4.1","fallback":"If I knew, I would have seated them."}
      ],
      [
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.5.0","fallback":"How long have you been waiting?"},
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.5.1","fallback":"Long enough that I have replaced the silver more often than I have spoken my own name."}
      ],
      [
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.6.0","fallback":"The family is gone."},
        {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.talk.6.1","fallback":"A household is not absolved of its standards merely because its occupants have become inconsiderate."}
      ]
    ],
    "attack_choice_label": {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.attack_choice_label","fallback":"This house has kept you long enough."},
    "spare_choice_label": {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.spare_choice_label","fallback":"I will find out who you are waiting for."},
    "attack_return_line": {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.attack_return_line","fallback":"Merrin's service ends by force. The thirteenth place remains empty."},
    "spared_line": {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.spared_line","fallback":"Then please be thorough. The Master disliked incomplete answers almost as much as late guests."},
    "post_spare_line": {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.post_spare_line","fallback":"His private papers were kept in the study. I have not opened them. A servant who reads his master's letters is merely a thief with good posture."},
    "mercy_outcome": {
      "offer_quest_chance": 100,
      "offered_quest": "mebahelrpgrquest:blackthorn_chain_3_the_final_guest",
      "ambush_chance": 0,
      "ambush_player": 0,
      "ambush_quest_giver": 0,
      "nothing_chance": 0,
      "offer_line": {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.mercy_outcome.offer_line","fallback":"If you mean to investigate, begin with the Master's study. Bring me the truth, even if it is discourteous."}
    }
  },
