  "quest_book": {
    "title": {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.quest_book.title","fallback":"Dinner at Blackthorn House"},
    "author": "M.",
    "color": "gray",
    "pages": [
      {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.quest_book.pages.0","fallback":"BLACKTHORN HOUSE\n\nThe household requests the pleasure of your company at dinner."},
      {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.quest_book.pages.1","fallback":"The table will be laid at dusk."},
      {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.quest_book.pages.2","fallback":"Formal dress is appreciated but no longer enforced."},
      {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.quest_book.pages.3","fallback":"Your arrival has been anticipated."},
      {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.quest_book.pages.4","fallback":"One place remains vacant."},
      {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.quest_book.pages.5","fallback":"You need not bring anything."},
      {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.quest_book.pages.6","fallback":"The House remembers its guests."},
      {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.quest_book.pages.7","fallback":"Present this invitation at the door.\n\nM.\nSteward"}
    ],
    "auto_claim_rewards": true
  }
