      "name": {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.name","fallback":"Blackthorn Guest Ledger"},
      "tag": "blackthorn_guest_ledger",
      "quest_book": {
        "title": {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.quest_book.title","fallback":"Blackthorn Guest Ledger"},
        "author": "Merrin",
        "pages": [
          {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.quest_book.pages.0","fallback":"BLACKTHORN HOUSE\nDINNER REGISTER\n\nLord Alistair Blackthorn\nLady Ysabet Blackthorn\nTwelve invited guests."},
          {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.quest_book.pages.1","fallback":"1. Lord Peregrin Vale\n2. Mara Vale\n3. Father Elric\n4. Magistrate Hobb\n5. Ysra Pell\n6. Dorn Fell"},
          {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.quest_book.pages.2","fallback":"7. Lady Morwen Ash\n8. Sir Tavin Reed\n9. Oren Glass\n10. Mira Glass\n11. Doctor Wren\n12. Captain Sera Holt"},
          {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.quest_book.pages.3","fallback":"THIRTEENTH PLACE:\n\nLeave set.\nDo not clear.\nDo not assign without the Master's instruction."},
          {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.quest_book.pages.4","fallback":"All twelve guests arrived before dusk.\n\nThe thirteenth chair remained empty."},
          {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.quest_book.pages.5","fallback":"The Master ordered the place kept warm."},
          {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.quest_book.pages.6","fallback":"The guests departed.\n\nThe place remained set."},
          {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.quest_book.pages.7","fallback":"The family died.\n\nThe place remained set."},
          {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.quest_book.pages.8","fallback":"I have replaced the silver six times.\n\nI no longer remember when the dining room became quiet."},
          {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.goals.1.quest_book.pages.9","fallback":"The order remains."}
        ]
      },
      "auto_advance": true
    },
