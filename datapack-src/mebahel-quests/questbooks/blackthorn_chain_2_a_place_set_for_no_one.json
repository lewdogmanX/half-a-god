  "threat": {
    "entity": "minecraft:skeleton",
    "name": {"translate":"quest.mebahelrpgrquest.blackthorn_chain_2_a_place_set_for_no_one.threat.name","fallback":"Merrin, the Last Servant"},
    "structure": "minecraft:mansion",
    "search_radius": 24000,
    "stage": 2,
    "spawn_on_accept": true,
    "spawn_min_radius": 5,
    "spawn_max_radius": 12,
    "spare": true,
