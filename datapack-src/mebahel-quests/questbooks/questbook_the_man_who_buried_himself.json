  "quest_book": {
    "title": {
      "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.title",
      "fallback": "The Man Who Buried Himself"
    },
    "author": {
      "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.author",
      "fallback": "Calder Venn"
    },
    "color": "gray",
    "pages": [
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.pages.0",
        "fallback": "I have begun keeping count of my own footsteps.\n\nThis is not something a sane man does.\n\nI am writing that down because I would like at least one honest sentence left if this journal is found."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.pages.1",
        "fallback": "Three nights ago I heard a pickaxe deeper in the mine.\n\nOne strike after mine.\n\nAlways one.\n\nI stopped. It stopped.\nI struck twice. It answered twice."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.pages.2",
        "fallback": "I thought another miner had found my tunnel.\n\nI called out.\n\nMy own voice answered from beyond the timber supports.\n\nNot an echo. It coughed before repeating my words."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.pages.3",
        "fallback": "This morning I found footprints in the dust.\n\nSame boots as mine. Same split heel. Same missing nail on the left sole.\n\nThey began where my tracks ended."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.pages.4",
        "fallback": "I sent the others back to the surface. Told them the supports were failing.\n\nCowardly lie.\n\nUseful lie.\n\nWhatever is following me has shown no interest in anyone else."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.pages.5",
        "fallback": "I started walling passages behind me.\n\nEvery morning one wall has a fresh mark on the other side.\n\nNot scratches.\n\nPickaxe blows."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.pages.6",
        "fallback": "Tonight I saw a hand beneath the last support.\n\nIt wore my wedding ring.\n\nMine is still on my finger."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.pages.7",
        "fallback": "There is an abandoned chamber deeper in the mineshaft. I am taking stone, food, and this journal there.\n\nI will build the wall with myself inside it."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.pages.8",
        "fallback": "If the thing is me, then burying myself buries it too.\n\nIf it is not me, perhaps it will stay outside trying to become a man no one can reach."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.quest_book.pages.9",
        "fallback": "I am leaving the final pages in the chamber.\n\nDo not open the wall because you want an answer.\n\nSome answers become worse when they can walk."
      }
    ],
    "auto_claim_rewards": true
  }
}
