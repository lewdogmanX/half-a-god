        "fallback": "Calder's Last Page"
      },
      "tag": "calder_venn_last_page",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.goals.1.quest_book.title",
          "fallback": "The Last Page"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.goals.1.quest_book.author",
          "fallback": "Calder Venn"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.goals.1.quest_book.pages.0",
            "fallback": "I stopped digging for an hour.\n\nThe other pick stopped too.\n\nI coughed. Something beyond the wall coughed a moment later."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.goals.1.quest_book.pages.1",
            "fallback": "There are two shadows when I hold one torch.\n\nI checked three times.\n\nOne belongs to me.\n\nThe other begins at my boots."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.goals.1.quest_book.pages.2",
            "fallback": "I have built the wall from the inside. Four stones thick where the old support split.\n\nIf the thing wants my face, it can have it in here where no one else has to see."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.goals.1.quest_book.pages.3",
            "fallback": "If someone finds this, leave the wall closed.\n\nIf curiosity wins, look carefully at what comes out."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.goals.1.quest_book.pages.4",
            "fallback": "If there are two of me, I was right.\n\nIf there is only one, I was worse."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_buried_himself.goals.1.quest_book.pages.5",
            "fallback": "Do not ask which one is Calder.\n\nI no longer know what answer would prove it."
          }
        ]
      },
      "auto_advance": true
    },
