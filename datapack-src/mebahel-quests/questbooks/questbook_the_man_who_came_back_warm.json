      },
      "tag": "edric_hale_nether_journal",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.goals.3.quest_book.title",
          "fallback": "What Answered Me"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.goals.3.quest_book.author",
          "fallback": "Edric Hale"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.goals.3.quest_book.pages.0",
            "fallback": "I found the second portal beneath the black stairs. It is unlit, but every night I hear Lysa calling from the other side."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.goals.3.quest_book.pages.1",
            "fallback": "Lysa has been dead for six years.\n\nI know that sentence. I have written it twelve times.\n\nStill, when she says my name, I answer."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.goals.3.quest_book.pages.2",
            "fallback": "The thing knows her voice now. Yesterday it used mine too.\n\nIt asked me to light the portal so that 'we can all go home.'"
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.goals.3.quest_book.pages.3",
            "fallback": "I killed the three skeletons watching this chamber. They were not guards. They were listeners. Every one of them turned its skull toward the portal whenever she spoke."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.goals.3.quest_book.pages.4",
            "fallback": "I am going back through my own portal instead.\n\nIf I return and I am warm, do not trust me.\n\nNothing living stays warm this long down here."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.goals.3.quest_book.pages.5",
            "fallback": "If something reaches the Overworld wearing my face, kill it before it learns another voice."
          }
        ]
      },
      "auto_advance": true
    },
    {
      "id": "silence_the_listeners",
      "kill": "minecraft:wither_skeleton",
