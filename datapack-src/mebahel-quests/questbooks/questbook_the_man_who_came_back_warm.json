  "quest_book": {
    "title": {
      "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.quest_book.title",
      "fallback": "The Man Who Came Back Warm"
    },
    "author": {
      "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.quest_book.author",
      "fallback": "Edric Hale"
    },
    "color": "red",
    "pages": [
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.quest_book.pages.0",
        "fallback": "If this journal is in someone else's hands, I either found the road home or failed badly enough that my belongings became public property."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.quest_book.pages.1",
        "fallback": "A ruined portal swallowed me when the floor beneath it collapsed. I woke in the Nether with half a frame behind me and no fire to wake it."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.quest_book.pages.2",
        "fallback": "I followed a fortress until I found another broken portal beneath black stone stairs. That is where I first heard my wife call my name."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.quest_book.pages.3",
        "fallback": "Her name was Lysa.\n\nShe died six years ago.\n\nI buried her myself."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.quest_book.pages.4",
        "fallback": "The first time she called, I ran toward the sound.\n\nThe second time, I answered.\n\nThe third time, something laughed with my voice."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.quest_book.pages.5",
        "fallback": "Three black skeletons watch the chamber. They never attack the portal. They only listen."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.quest_book.pages.6",
        "fallback": "I have decided to leave the second portal dark. I will return the way I came, even if it takes weeks."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.quest_book.pages.7",
        "fallback": "If you find my ruined portal, follow my route and read what I left in the fortress.\n\nI need someone else to know what learned our voices down there."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_man_who_came_back_warm.quest_book.pages.8",
        "fallback": "One last thing.\n\nThe Nether has baked the water from my skin and the sleep from my head.\n\nIf I ever come home warm, that is not me."
      }
    ],
    "auto_claim_rewards": true
  }
}
