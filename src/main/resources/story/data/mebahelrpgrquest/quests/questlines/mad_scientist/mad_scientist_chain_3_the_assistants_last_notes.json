      "amount": 1,
      "structure": "minecraft:mineshaft",
      "container": "minecraft:barrel",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.mad_scientist_chain_3_the_assistants_last_notes.goals.1.quest_book.title",
          "fallback": "Sera's Field Notes"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.mad_scientist_chain_3_the_assistants_last_notes.goals.1.quest_book.author",
          "fallback": "Sera Marr"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.mad_scientist_chain_3_the_assistants_last_notes.goals.1.quest_book.pages.0",
            "fallback": "Trial 18: Vale's restorative closes necrotic wounds. The tissue does not stop afterward. He calls the extra growth acceptable variance."
          },
          {
            "translate": "quest.mebahelrpgrquest.mad_scientist_chain_3_the_assistants_last_notes.goals.1.quest_book.pages.1",
            "fallback": "Trial 21: he increased the redstone concentration again. The cadaver gained nearly a handspan in height before the restraints broke."
          },
          {
            "translate": "quest.mebahelrpgrquest.mad_scientist_chain_3_the_assistants_last_notes.goals.1.quest_book.pages.2",
            "fallback": "I was bitten moving the last subject. Vale says the restorative can save me. I want to believe him. I know too much not to be afraid."
          },
          {
            "translate": "quest.mebahelrpgrquest.mad_scientist_chain_3_the_assistants_last_notes.goals.1.quest_book.pages.3",
            "fallback": "Third dose. Hunger worse. Hands larger. He wants a fourth. I said no. If I still know my name tomorrow, I am leaving. My name is Sera Marr. My name is Sera Marr."
          }
        ]
      },
      "auto_advance": true,
      "stage": 1,
      "radius": 3400,
      "name": {
        "translate": "quest.mebahelrpgrquest.mad_scientist_chain_3_the_assistants_last_notes.goals.1.name",
        "fallback": "Sera's Field Notes"
