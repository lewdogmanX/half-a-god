{
  "title": {
    "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.title",
    "fallback": "A Skull for Proof"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.summary",
    "fallback": "Enter the Nether, track the fortress command line, and take a Wither captain's skull as proof."
  },
  "sequential_objectives": true,
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.intro",
      "fallback": "Breaking the anchor stopped the skeletons for now, but it also told the other side that the village can bite back."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.offer.0.0",
          "fallback": "You want a Wither skull?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.offer.0.1",
          "fallback": "I want proof strong enough that no elder, guard, or coward can call this a cave problem. A skull from a Wither skeleton captain will do."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.offer.1.0",
          "fallback": "Taking one may provoke them."
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.offer.1.1",
          "fallback": "Yes. But they already reached for us. Better to know whose hand it is before the whole arm comes through."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.offer.2.0",
          "fallback": "Where do I start?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.offer.2.1",
          "fallback": "Go through a Nether portal first. Once you are there, follow the fortress lines. The captain will be inside, not wandering outside like a stray."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.return",
      "fallback": "That skull is still warm. Not with fire - with notice. Whatever commanded the anchor knows it has lost a head."
    },
    "return_steps": [
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.return_steps.0.0",
          "fallback": "So this proves it?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.return_steps.0.1",
          "fallback": "It proves the village was marked by the Nether, and that a Wither captain stood behind the marked bones."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.return_steps.1.0",
          "fallback": "Will they come for it?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.return_steps.1.1",
          "fallback": "Yes. Maybe tonight, maybe after they gather enough hate to make a road. But they will come."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.return_steps.2.0",
          "fallback": "Then this is not over."
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.return_steps.2.1",
          "fallback": "No. This was the warning. The next sound will be the answer."
        }
      ]
    ],
    "reward": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.reward",
      "fallback": "Keep your weapons close. You ended the cleanup, but you also gave the Nether a reason to remember your name."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_3_a_skull_for_proof.dialogue.done",
      "fallback": "The skull is proof, and proof has consequences."
    }
  },
