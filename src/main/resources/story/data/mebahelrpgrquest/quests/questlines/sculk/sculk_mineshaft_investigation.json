{
  "title": {
    "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.title",
    "fallback": "The Mine That Listens"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.summary",
    "fallback": "Investigate a silent mineshaft where sculk is growing around an altered skeleton spawner, then destroy the source with TNT."
  },
  "sequential_objectives": true,
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.intro",
      "fallback": "A miner came back from an old shaft without his tools. He says the rails were covered in blue growth and skeletons watched him without bows in their hands."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.offer.0.0",
          "fallback": "Skeletons without bows?"
        },
        {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.offer.0.1",
          "fallback": "That is what frightened him most. They did not hunt. They stood around the spawner with sculk on their skulls, listening to the stone."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.offer.1.0",
          "fallback": "What is spreading down there?"
        },
        {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.offer.1.1",
          "fallback": "Sculk, if the miner saw clearly. But sculk should not grow from a spawner. Find his foreman's notes before you touch the cage."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.offer.2.0",
          "fallback": "Why bring TNT?"
        },
        {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.offer.2.1",
          "fallback": "The miner struck the spawner with a pick. The sculk pulsed and the dead woke together. Do not give it another warning."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.return",
      "fallback": "The miner heard the blast from the surface. Afterward, the scratching beneath the rails stopped."
    },
    "return_steps": [
      [
        {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.return_steps.0.0",
          "fallback": "The sculk had changed the skeletons."
        },
        {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.return_steps.0.1",
          "fallback": "Or the spawner changed the sculk. Either answer is bad enough. At least the mine is no longer teaching the dead to listen."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.return_steps.1.0",
          "fallback": "The growth is still in the chamber."
        },
        {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.return_steps.1.1",
          "fallback": "Then we seal that branch and mark every map. Dead sculk is safer than a living cage, but nobody should build over it."
        }
      ]
    ],
    "reward": {
      "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.reward",
      "fallback": "You found the truth before swinging a pick, and you brought the chamber down the right way. Take this for the risk."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.dialogue.done",
      "fallback": "The old shaft is sealed. Sometimes the miners still hear a click below, but it never answers twice."
    }
  },
  "goals": [
    {
      "id": "reach_listening_mine",
      "reach": "minecraft:mineshaft",
      "structure": "minecraft:mineshaft",
      "auto_advance": true,
      "stage": 0,
      "radius": 3200,
      "range": 80,
      "say": {
        "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.goals.0.say",
        "fallback": "The rails vanish beneath sculk veins. Farther in, something clicks in the rhythm of a mob spawner."
      }
    },
    {
      "id": "recover_foreman_notes",
      "type": "read_book",
      "item": "minecraft:written_book",
      "amount": 1,
      "structure": "minecraft:mineshaft",
      "container": "minecraft:barrel",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.goals.1.quest_book.title",
          "fallback": "Foreman's Last Survey"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.goals.1.quest_book.author",
          "fallback": "Foreman Darek"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.goals.1.quest_book.pages.0",
            "fallback": "Third shift. Blue veins have crossed the western rail and reached the old skeleton cage. They pulse whenever a cart moves."
          },
          {
            "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.goals.1.quest_book.pages.1",
            "fallback": "The skeletons no longer carry bows. Each one grows a dark blue crown over the skull. They face every sound at once."
          },
          {
            "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.goals.1.quest_book.pages.2",
            "fallback": "Breaking the growth only makes the cage spin faster. The supports around it are already hollow."
          },
          {
            "translate": "quest.mebahelrpgrquest.sculk_mineshaft_investigation.goals.1.quest_book.pages.3",
            "fallback": "If anyone returns, place the powder beside the cage and bring the whole chamber down. Do not strike the spawner by hand."
          }
        ]
      },
