      "completion_dialogue_line": {
        "translate": "quest.mebahelrpgrquest.blackthorn_chain_4_a_seat_for_the_dead.goals.3.completion_dialogue_line",
        "fallback": "For twelve quiet seconds, nobody arrives. Merrin almost relaxes. Then the house answers with the footsteps of its former servants."
      }
