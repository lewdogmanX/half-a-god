      "stage": 2,
      "in_chest": true,
      "container": "minecraft:barrel",
      "name": {
        "translate": "quest.mebahelrpgrquest.false_hero_rusk_no_banner_behind_me.goals.read_black_road_ledger.name",
        "fallback": "Black-Road Ledger"
      },
      "tag": "rusk_black_road_ledger",
      "quest_book": {
        "title": "Black-Road Ledger",
        "author": "Hadrik Black-Sash",
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.false_hero_rusk_no_banner_behind_me.ledger.pages.0",
            "fallback": "WEST ROAD ACCOUNTS\n\nVale crossing - paid.\nMill bridge - paid.\nBluebell village - refused.\nNorth ford - route sold."
          },
          {
            "translate": "quest.mebahelrpgrquest.false_hero_rusk_no_banner_behind_me.ledger.pages.1",
            "fallback": "Rusk: scouted Bluebell approach. Two guards, one golem, weak eastern fence. Full share."
          },
          {
            "translate": "quest.mebahelrpgrquest.false_hero_rusk_no_banner_behind_me.ledger.pages.2",
            "fallback": "Rusk: led west-road party. Merchant cart taken intact. Driver survived. Half share after dispute."
          },
          {
            "translate": "quest.mebahelrpgrquest.false_hero_rusk_no_banner_behind_me.ledger.pages.3",
            "fallback": "Rusk: night watch at Harth farm. House burned during collection. Claims he did not light it. Captain notes that ash spends the same."
          },
          {
            "translate": "quest.mebahelrpgrquest.false_hero_rusk_no_banner_behind_me.ledger.pages.4",
            "fallback": "Rusk: unreliable since medal affair. Asked twice whether prisoners were necessary. Watch him."
          },
          {
            "translate": "quest.mebahelrpgrquest.false_hero_rusk_no_banner_behind_me.ledger.pages.5",
            "fallback": "Rusk: gone. If found, kill before he learns how much of this ledger has his name in it."
          }
        ]
      }
    }
  ],
