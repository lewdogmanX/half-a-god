  "quest_book": {
    "title": {
      "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.quest_book.title",
      "fallback": "A Very Reasonable Treasure Map"
    },
    "author": {
      "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.quest_book.author",
      "fallback": "Bastian Quill, Licensed Treasure Hunter"
    },
    "color": "yellow",
    "pages": [
      {
        "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.quest_book.pages.0",
        "fallback": "A VERY REASONABLE TREASURE MAP\n\nProperty of Bastian Quill, licensed treasure hunter, amateur cartographer, and man suffering from absolutely no curse whatsoever."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.quest_book.pages.1",
        "fallback": "First, a legal clarification.\n\nI am not cursed.\n\nI have never been cursed.\n\nAny screaming heard while I owned this map was unrelated to the map and, in several cases, exaggerated."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.quest_book.pages.2",
        "fallback": "The treasure lies beside an old ruined Nether portal.\n\nYou will recognize the correct sort of place immediately: broken stone, unpleasant air, and the strong feeling that someone made a poor decision there."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.quest_book.pages.3",
        "fallback": "Before going, acquire one fresh cod.\n\nThis is for diplomacy.\n\nIf the cod vanishes from your possession during the journey, diplomacy has succeeded. Do not investigate further."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.quest_book.pages.4",
        "fallback": "At the ruined portal, place a carved pumpkin close to the old frame.\n\nThe pumpkin is for protection.\n\nDo not put the cod on your head and attempt to negotiate with the pumpkin. I tried that."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.quest_book.pages.5",
        "fallback": "Then wait until night.\n\nThis is important. Treasure of this quality dislikes daylight.\n\nSo did my three business partners, toward the end."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.quest_book.pages.6",
        "fallback": "If three dead men appear, remain calm.\n\nThey may claim I betrayed them, stole the map, abandoned them underground, or used them to test a curse-transfer ritual.\n\nThese accusations are technically historical."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.quest_book.pages.7",
        "fallback": "Once they are dealt with, search the portal ruins carefully. I left a receipt with the treasure.\n\nPlease read it before spending anything.\n\nFor bookkeeping reasons."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.quest_book.pages.8",
        "fallback": "One final assurance:\n\nThe route is safe.\nThe instructions are reasonable.\nThe treasure is valuable.\n\nTwo of those statements are entirely true."
      }
    ],
    "auto_claim_rewards": true
  }
}