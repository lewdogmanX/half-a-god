      "tag": "bastian_quill_curse_receipt",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.goals.5.quest_book.title",
          "fallback": "Receipt of Transfer"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.goals.5.quest_book.author",
          "fallback": "Bastian Quill"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.goals.5.quest_book.pages.0",
            "fallback": "TRANSFER RECEIPT\n\nOne (1) persistent funerary curse, origin disputed, transferred in full to the bearer who completed the prescribed rite."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.goals.5.quest_book.pages.1",
            "fallback": "Prescribed rite:\n\nOne fish surrendered.\nOne smiling guardian raised.\nOne moon witnessed.\nThree creditors returned to rest.\n\nAll conditions satisfied."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.goals.5.quest_book.pages.2",
            "fallback": "If you are reading this, congratulations. The treasure is now legally yours.\n\nSo is everything that was attached to it."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.goals.5.quest_book.pages.3",
            "fallback": "Before you become upset, please note that I did write 'entirely uncursed' in the map.\n\nI did not write 'the treasure'."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_a_very_reasonable_treasure_map.goals.5.quest_book.pages.4",
            "fallback": "I recommend avoiding mirrors for several days.\n\nWarmest regards,\nBastian Quill\nFormerly Cursed"
          }
        ]
      }
    }
  ],
