  "quest_book": {
    "title": {
      "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.title",
      "fallback": "The Fourth Member"
    },
    "author": {
      "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.author",
      "fallback": "Vessa Marr"
    },
    "color": "purple",
    "pages": [
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.pages.0",
        "fallback": "EXPEDITION JOURNAL\n\nMembers:\nJorn Vale\nVessa Marr\nHaldrin Pike\n\nThree of us. Three shares. No hired hands."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.pages.1",
        "fallback": "Jorn found a stronghold map in a ruined library. Haldrin says the place will already be picked clean.\n\nI say an empty ruin is still worth seeing once."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.pages.2",
        "fallback": "We crossed the river before dusk. Jorn fell in and blamed the current. Haldrin blamed Jorn. I laughed until my ribs hurt."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.pages.3",
        "fallback": "Merrick made breakfast this morning.\n\nHe burned it again."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.pages.4",
        "fallback": "I read that sentence back three times.\n\nI do not remember writing Merrick's name before today."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.pages.5",
        "fallback": "Jorn says Merrick has travelled with us since the birch road.\n\nHaldrin says longer.\n\nBoth looked genuinely worried when I asked what they meant."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.pages.6",
        "fallback": "The worst part is that I remember him now.\n\nMerrick at the river. Merrick carrying my pack when I hurt my ankle. Merrick singing badly in the rain."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.pages.7",
        "fallback": "Those memories feel older than this journal.\n\nThis journal says they are lies."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.pages.8",
        "fallback": "We reached the stronghold.\n\nI am leaving this journal where another traveller may find it. Inside, I will keep a second ledger from this point onward."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.quest_book.pages.9",
        "fallback": "There were three of us when we entered.\n\nI am writing that sentence while I still know it is true."
      }
    ],
