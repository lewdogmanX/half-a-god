      "name": {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.1.name",
        "fallback": "Expedition Ledger"
      },
      "tag": "fourth_member_expedition_ledger",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.1.quest_book.title",
          "fallback": "Expedition Ledger"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.1.quest_book.author",
          "fallback": "Vessa Marr"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.1.quest_book.pages.0",
            "fallback": "SUPPLIES AT ENTRY\n\nJorn Vale\nVessa Marr\nHaldrin Pike\n\nThree bedrolls. Three torches each. Three shares of food. Three shares of whatever we find."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.1.quest_book.pages.1",
            "fallback": "Someone changed the food tally to four.\n\nJorn says I did it because I always forget Merrick's share.\n\nI asked him who Merrick was."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.1.quest_book.pages.2",
            "fallback": "Jorn stared at me for a long time.\n\nThen he laughed and asked whether I had struck my head.\n\nHaldrin laughed too."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.1.quest_book.pages.3",
            "fallback": "I remember Merrick telling that joke by the river.\n\nI remember being angry with him.\n\nThere was no Merrick at the river."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.1.quest_book.pages.4",
            "fallback": "I checked the first page again.\n\nThree names.\n\nThe ink is mine.\n\nWhy did I pack four cups?"
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.1.quest_book.pages.5",
            "fallback": "Merrick says the lower hall is safe.\n\nI do not remember seeing him enter this place.\n\nI do remember him walking in front of me."
          }
        ]
      },
      "auto_advance": true
    },
    {
      "id": "put_the_expedition_to_rest",
      "kill": "minecraft:zombie",
      "amount": 3,
      "stage": 2,
      "from_threats": true,
      "auto_advance": true
    },
    {
      "id": "read_the_last_count",
      "type": "read_book",
      "item": "minecraft:written_book",
      "amount": 1,
      "structure": "minecraft:stronghold",
      "radius": 30000000,
      "stage": 3,
      "in_chest": true,
      "container": "minecraft:chest",
      "name": {
        "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.3.name",
        "fallback": "The Last Count"
      },
      "tag": "fourth_member_last_count",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.3.quest_book.title",
          "fallback": "The Last Count"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.3.quest_book.author",
          "fallback": "Vessa Marr"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.3.quest_book.pages.0",
            "fallback": "Jorn. Vessa. Haldrin.\n\nThree names.\n\nI have counted them twenty times."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.3.quest_book.pages.1",
            "fallback": "Jorn is dead. Haldrin is dead. I will be soon.\n\nMerrick is sitting across from me and asking why I keep writing only three names."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.3.quest_book.pages.2",
            "fallback": "He remembers my mother.\n\nHe remembers the red scarf Jorn lost last winter.\n\nHe remembers things I remember too.\n\nThat is what frightens me."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.3.quest_book.pages.3",
            "fallback": "I asked Merrick where we first met.\n\nHe said, 'You know where.'\n\nFor one heartbeat I did."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.3.quest_book.pages.4",
            "fallback": "There were three of us when we entered.\n\nI know this because I wrote it before the memories changed."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.3.quest_book.pages.5",
            "fallback": "Now I remember four voices around every fire we ever made."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.3.quest_book.pages.6",
            "fallback": "If you find this book alone, do not count us again."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_fourth_member.goals.3.quest_book.pages.7",
            "fallback": "And if a man named Merrick ever asks whether you remember him, do not answer."
          }
        ]
      }
    }
  ],
