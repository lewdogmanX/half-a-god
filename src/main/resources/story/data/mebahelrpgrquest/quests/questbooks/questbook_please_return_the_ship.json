  "quest_book": {
    "title": {
      "translate": "quest.mebahelrpgrquest.questbook_please_return_the_ship.quest_book.title",
      "fallback": "Please Return the Ship"
    },
    "author": {
      "translate": "quest.mebahelrpgrquest.questbook_please_return_the_ship.quest_book.author",
      "fallback": "Marrow & Finch Recovery"
    },
    "color": "blue",
    "pages": [
      {
        "translate": "quest.mebahelrpgrquest.questbook_please_return_the_ship.quest_book.pages.0",
        "fallback": "NOTICE OF UNRETURNED PROPERTY\n\nVessel: Patient Gull\nBorrower: Edric Moor\nReturn date: nineteen years overdue."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_please_return_the_ship.quest_book.pages.1",
        "fallback": "Penalty: two emeralds per day, plus administrative costs, harbor costs, recovery costs, weather costs, and costs associated with calculating costs."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_please_return_the_ship.quest_book.pages.2",
        "fallback": "The vessel remains company property regardless of weather, piracy, sinking, structural disassembly, acts of gods, acts of fish, or borrower inconvenience."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_please_return_the_ship.quest_book.pages.3",
        "fallback": "Salvage agents are authorized to locate the Patient Gull and recover company property from the borrower."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_please_return_the_ship.quest_book.pages.4",
        "fallback": "Clause Nine: death of the borrower does not void outstanding maritime obligations."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_please_return_the_ship.quest_book.pages.5",
        "fallback": "Last reported wreckage lies somewhere along the coast. Return the ship in serviceable condition where possible. Where impossible, return it anyway."
      }
    ],
    "loot": [
      {
        "table": "minecraft:chests/village/village_cartographer",
        "chance": 0.07
      },
      {
        "table": "minecraft:chests/shipwreck_map",
        "chance": 0.05
      }
    ],
    "auto_claim_rewards": true
  }
