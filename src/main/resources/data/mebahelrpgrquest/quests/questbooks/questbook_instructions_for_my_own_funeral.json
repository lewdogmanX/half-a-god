    }
  },
  "traits": {
    "complete": [
      "garrick_killed_again",
      "hag_base_funeral_done"
    ]
  },
  "quest_book": {
    "title": {
      "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.title",
      "fallback": "Instructions for My Own Funeral"
    },
    "author": {
      "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.author",
      "fallback": "Garrick Bell"
    },
    "color": "purple",
    "pages": [
      {
        "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.pages.0",
        "fallback": "INSTRUCTIONS FOR MY FUNERAL\n\nTo be followed exactly.\n\nI have attended four funerals in my life and all were organized by amateurs."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.pages.1",
        "fallback": "One: three candles. Not two. Not four. Three.\n\nTwo: no red flowers. They make me look cheap."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.pages.2",
        "fallback": "Three: one egg must be present.\n\nThis is a family matter and none of your concern."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.pages.3",
        "fallback": "Four: my sword goes on the right side.\n\nI am right-handed. I refuse to spend eternity reaching across myself."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.pages.4",
        "fallback": "Five through nine concern acceptable bread, seating, weather, and my nephew Corwin. Corwin is not to improvise anything."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.pages.5",
        "fallback": "Ten: bury me near old ruined stone. I always liked ruins. They make one's own failures seem modest."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.pages.6",
        "fallback": "Eleven: place the three candles close to the grave.\n\nTwelve: wait until after sunset before finishing the ceremony."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.pages.7",
        "fallback": "Thirteen: if I make a noise, do not panic.\n\nFourteen: if I sit up, remain calm.\n\nFifteen: if I ask for water, do not give me any. It only encourages things."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.pages.8",
        "fallback": "Sixteen: if I stand, consult Paragraph Seventeen.\n\nEighteen: under no circumstances let Corwin claim I wanted a closed casket."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.pages.9",
        "fallback": "Nineteen: if all instructions are followed, my estate will compensate whoever endured this nonsense."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.quest_book.pages.10",
        "fallback": "Twenty: if something goes wrong, I accept no responsibility.\n\nI will be dead."
      }
    ],
    "auto_claim_rewards": true
  }
}