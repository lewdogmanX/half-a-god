          "count": 1,
          "name": {
            "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.threats.0.drop_on_death.0.name",
            "fallback": "Instructions for My Second Funeral"
          },
          "tag": "garrick_bell_second_funeral",
          "quest_book": {
            "title": {
              "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.threats.0.drop_on_death.0.quest_book.title",
              "fallback": "My Second Funeral Instructions"
            },
            "author": {
              "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.threats.0.drop_on_death.0.quest_book.author",
              "fallback": "Garrick Bell"
            },
            "pages": [
              {
                "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.threats.0.drop_on_death.0.quest_book.pages.0",
                "fallback": "If you are reading this, then you killed me again. I would like to begin by saying that this was specifically covered in the instructions."
              },
              {
                "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.threats.0.drop_on_death.0.quest_book.pages.1",
                "fallback": "Paragraph Seventeen read: 'If I stand up, do not kill me. Strike the bell twice and wait.'"
              },
              {
                "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.threats.0.drop_on_death.0.quest_book.pages.2",
                "fallback": "The copy you found skipped directly from Sixteen to Eighteen because my nephew Corwin copied it. This is exactly why Corwin was not supposed to copy anything."
              },
              {
                "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.threats.0.drop_on_death.0.quest_book.pages.3",
                "fallback": "SECOND FUNERAL: Bring one bell and one candle back to the old ruined stone. The egg is no longer required. Please stop bringing eggs to my grave."
              },
              {
                "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.threats.0.drop_on_death.0.quest_book.pages.4",
                "fallback": "Place the bell and candle near the grave. Wait until night. If I stand again, speak to me before doing anything involving a sword."
              },
              {
                "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.threats.0.drop_on_death.0.quest_book.pages.5",
                "fallback": "If I am coherent, I am not hostile. If I ask for brains, you may revise this assessment."
              },
              {
                "translate": "quest.mebahelrpgrquest.questbook_instructions_for_my_own_funeral.threats.0.drop_on_death.0.quest_book.pages.6",
                "fallback": "I have prepared a third volume as a precaution. This should not be interpreted as confidence in your ability to follow the second."
              }
            ]
          }
        }
      ]
    }
  ],
  "rewards": {
    "xp": 420,
    "items": {
