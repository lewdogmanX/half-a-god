  "quest_book": {
    "title": {
      "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.quest_book.title",
      "fallback": "The House That Owes Me Money"
    },
    "author": {
      "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.quest_book.author",
      "fallback": "Hadrin Pell, Licensed Collector"
    },
    "color": "green",
    "pages": [
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.quest_book.pages.0",
        "fallback": "NOTICE OF DELINQUENT PROPERTY\n\nThe residence presently standing on Lot Seven owes me fourteen emeralds."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.quest_book.pages.1",
        "fallback": "To be clear, I do not mean the owner.\n\nThe owner moved away three months ago and was, in all financial matters, exemplary."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.quest_book.pages.2",
        "fallback": "The house itself owes me money."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.quest_book.pages.3",
        "fallback": "I concealed fourteen emeralds somewhere inside the property during a period of temporary concern regarding taxation."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.quest_book.pages.4",
        "fallback": "Upon returning, I was unable to locate them.\n\nThe house has therefore retained money belonging to me without consent."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.quest_book.pages.5",
        "fallback": "I attempted peaceful recovery.\n\nI knocked.\nI threatened legal action.\nI read the relevant statute aloud through the window."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.quest_book.pages.6",
        "fallback": "During the third reading, the front door closed by itself.\n\nHostile negotiation."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.quest_book.pages.7",
        "fallback": "If you find this notice, locate the property, search its records, and recover the fourteen emeralds."
      },
      {
        "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.quest_book.pages.8",
        "fallback": "You may keep a reasonable collection fee.\n\nDo not allow the house to intimidate you.\n\nIt is property."
      }
    ],
    "auto_claim_rewards": true
  }
}