      "tag": "house_debt_final_demand",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.goals.1.quest_book.title",
          "fallback": "Final Demand to Premises"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.goals.1.quest_book.author",
          "fallback": "Hadrin Pell, Collector"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.goals.1.quest_book.pages.0",
            "fallback": "TO THE HOUSE CURRENTLY OCCUPYING LOT SEVEN:\n\nYou owe me fourteen emeralds."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.goals.1.quest_book.pages.1",
            "fallback": "I have knocked politely on six occasions. You have declined to answer on all six."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.goals.1.quest_book.pages.2",
            "fallback": "On my seventh visit, a shutter fell from the upper window and struck my hat.\n\nI consider this intimidation."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.goals.1.quest_book.pages.3",
            "fallback": "I have therefore authorized inspection of the foundations. The money was last seen entering the property in my possession."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_house_that_owes_me_money.goals.1.quest_book.pages.4",
            "fallback": "If fourteen emeralds are discovered beneath the floor, seize them immediately.\n\nThis is not theft. This is accounting."
          }
        ]
      },
      "auto_advance": true
    },
    {
      "id": "recover_fourteen_emeralds",
