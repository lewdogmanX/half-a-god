{
  "title": {
    "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.title",
    "fallback": "The Captain's Share"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.summary",
    "fallback": "Follow the articles of the lost Saint Marrow, settle the crew's dead accounts, and decide who is entitled to the captain's final share."
  },
  "sequential_objectives": true,
  "flow": {
    "on_spare": {
      "delayed_next_quest": {
        "quest": "mebahelrpgrquest:captains_share_return_the_shares",
        "delay_ticks": 160,
        "conditions": {
          "dimensions": [
            "minecraft:overworld"
          ],
          "player_not_in_combat": true
        },
        "retry_delay_ticks": 200
      }
    }
  },
  "goals": [
    {
      "id": "find_the_saint_marrow",
      "reach": "minecraft:shipwreck",
      "radius": 5200,
      "range": 18,
      "stage": 0,
      "auto_advance": true
    },
    {
      "id": "read_the_ship_articles",
      "type": "read_book",
      "item": "minecraft:written_book",
      "amount": 1,
      "structure": "minecraft:shipwreck",
      "radius": 5200,
      "stage": 1,
      "in_chest": true,
      "allow_water_placement": true,
      "container": "minecraft:barrel",
      "name": {
        "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.goals.1.name",
        "fallback": "Saint Marrow's Articles"
      },
      "tag": "saint_marrow_articles",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.goals.1.quest_book.title",
          "fallback": "Saint Marrow's Articles"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.goals.1.quest_book.author",
          "fallback": "First Mate Orren"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.goals.1.quest_book.pages.0",
            "fallback": "SHIP'S ARTICLES\n\nSaint Marrow. Seven crew. Five passengers. Twelve shares of salvage. One additional captain's share after all other shares are paid."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.goals.1.quest_book.pages.1",
            "fallback": "No share passes to another sailor by death. A dead man's portion remains his until landfall, where it is delivered to his family or buried with his name."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.goals.1.quest_book.pages.2",
            "fallback": "First Mate Orren. Mara Fen. Hobb Tanner. Lysa Pell. Corven Dey. Neral Pike. Captain Vale.\n\nFive passengers entered separately in the manifest."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.goals.1.quest_book.pages.3",
            "fallback": "ADDENDUM, hand of Captain Vale:\n\nOrren drowned first. His share remained aboard. Mara followed two nights later. I moved both portions to the captain's chest for safekeeping."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.goals.1.quest_book.pages.4",
            "fallback": "SECOND ADDENDUM:\n\nHobb is dead. The others refuse to touch the chest. They say the articles were not a suggestion. Superstition is becoming expensive."
          },
          {
            "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.goals.1.quest_book.pages.5",
            "fallback": "FINAL ENTRY:\n\nThere are more shares in my chest than living names on my deck. The arithmetic is excellent. Everything else is not."
          }
        ]
      },
      "auto_advance": true
    },
    {
      "id": "put_the_crew_to_rest",
      "kill": "minecraft:drowned",
      "amount": 3,
      "stage": 2,
      "from_threats": true,
      "auto_advance": true
    },
    {
      "id": "hear_captain_vale",
      "talk": "minecraft:drowned",
      "amount": 1,
      "stage": 3,
      "quest_item_name": {
        "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.goals.3.quest_item_name",
        "fallback": "Captain Vale"
      }
    },
    {
      "id": "take_the_final_share",
      "kill": "minecraft:drowned",
      "amount": 1,
      "stage": 3,
      "attack_only": true,
      "from_threats": true
    }
  ],
  "threats": [
    {
      "entity": "minecraft:drowned",
      "name": {
        "translate": "quest.mebahelrpgrquest.questbook_the_captains_share.threats.0.name",
        "fallback": "First Mate Orren"
      },
      "stage": 2,
      "spawn_origin": "quest_target",
      "spawn_min_radius": 4,
      "spawn_max_radius": 9,
