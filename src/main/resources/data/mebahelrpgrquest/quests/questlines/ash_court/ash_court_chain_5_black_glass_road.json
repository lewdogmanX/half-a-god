{
  "title": {
    "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.title",
    "fallback": "The Black Glass Road"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.summary",
    "fallback": "Follow the skull's vision into the Nether, search a bastion, and recover the black-glass waystone once used to open a passage to the village."
  },
  "flow": {
    "next": "mebahelrpgrquest:ash_court_chain_6_the_court_answers"
  },
  "requires": {
    "quests": [
      "mebahelrpgrquest:ash_court_chain_4_the_warm_skull"
    ],
    "traits": [
      "ash_court_road_seen"
    ]
  },
  "sequential_objectives": true,
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.intro",
      "fallback": "The skull's vision has settled into one image: a broken road of black glass, gold behind walls, and a handprint burned into the stone."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.offer.0.0",
          "fallback": "What exactly am I looking for?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.offer.0.1",
          "fallback": "A waystone made of crying obsidian. The Court used stones like it to open short-lived passages for soldiers, prisoners, and supplies."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.offer.1.0",
          "fallback": "Why involve piglins at all?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.offer.1.1",
          "fallback": "Piglins know how to hide dangerous roads and how to keep a portal key dormant. Someone paid them to bury this one inside the bastion."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.offer.2.0",
          "fallback": "And if the bastion is guarded?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.offer.2.1",
          "fallback": "It will be. Do not make a war of it if you can avoid one, but the brutes guarding the waystone are being paid to keep that passage hidden."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.return",
      "fallback": "This is not a map. It is an invitation with teeth. See the lines inside the glass? They point to the village bell."
    },
    "return_steps": [
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.return_steps.0.0",
          "fallback": "The Ash Court has a passage to the village?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.return_steps.0.1",
          "fallback": "It did. The waystone contains the destination of the village bell. Someone used that route before and then paid to conceal it."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.return_steps.1.0",
          "fallback": "Can we destroy the waystone?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.return_steps.1.1",
          "fallback": "Not safely. Break an active portal key and the passage may tear open around every shard. We must discharge it through the bell first."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.return_steps.2.0",
          "fallback": "Then what is the answer?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.return_steps.2.1",
          "fallback": "We make the village the mouth of the trap. Let the Court send its voice through, then cut the voice where everyone can hear it die."
        }
      ]
    ],
    "reward": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.reward",
      "fallback": "You brought back the road. Now we choose where it ends."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_5_black_glass_road.dialogue.done",
      "fallback": "The waystone sleeps under salt and iron. Its carved route still ends beneath the village bell."
    }
  },
