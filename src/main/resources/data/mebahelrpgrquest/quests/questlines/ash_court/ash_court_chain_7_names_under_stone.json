        "consume_on_claim": true,
        "quest_book": {
          "title": {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.spare_handoff.quest_book.title",
            "fallback": "Iron Record of Deliveries"
          },
          "author": {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.spare_handoff.quest_book.author",
            "fallback": "Orr Veyl"
          },
          "pages": [
            {
              "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.spare_handoff.quest_book.pages.0",
              "fallback": "FIRST BELL AGREEMENT\n\nReceiving officer: Avar Khel.\nVillage signatory: Edran Vale.\nCollection point: black-glass waystone at the north road."
            },
            {
              "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.spare_handoff.quest_book.pages.1",
              "fallback": "Twelve prisoners received over twelve winters. Five remain in service beneath the Hall Beneath the Eye. Seven died in labor, escape attempts, or Court campaigns."
            },
            {
              "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.spare_handoff.quest_book.pages.2",
              "fallback": "Living prisoners:\nSelka of the East Road\nMara Voss\nTomas Reed\nUnknown man called Finch\nPell Arden, exile"
            },
            {
              "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.spare_handoff.quest_book.pages.3",
              "fallback": "Access route: ruined Nether fortress gate beneath the Eye chamber. The village ledger and waystone resonance are sufficient to open the old collection passage."
            },
            {
              "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.spare_handoff.quest_book.pages.4",
              "fallback": "Termination clause: the village representative may surrender the ward before Avar Khel. If Avar Khel dies, the ward and all Court claims created by the agreement end with him."
            }
          ]
        }
      },
