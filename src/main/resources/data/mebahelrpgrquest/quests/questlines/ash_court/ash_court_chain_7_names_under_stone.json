      "say": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.0.say",
        "fallback": "The resonator pulls toward a patch of deepslate split by netherrack and blackstone. The old collection route ends here."
      }
    },
    {
      "id": "recover_founders_ledger",
      "collect": "minecraft:written_book",
      "amount": 1,
      "structure": "minecraft:ancient_city",
      "radius": 15000,
      "in_chest": true,
      "container": "minecraft:barrel",
      "name": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.1.name",
        "fallback": "Ledger of the First Bell"
      },
      "tag": "ash_court_founders_ledger",
      "quest_book": {
        "title": {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.1.quest_book.title",
          "fallback": "Ledger of the First Bell"
        },
        "author": {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.1.quest_book.author",
          "fallback": "Edran Vale, First Bell-Keeper"
        },
        "pages": [
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.1.quest_book.pages.0",
            "fallback": "Winter, Year 0\n\nThe red fever has taken thirty-one villagers. Avar Khel offers medicine, armed sentries, and a ward against undead in return for one living prisoner each winter."
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.1.quest_book.pages.1",
            "fallback": "The prisoner must be delivered alive to the black-glass waystone beyond the north road. When the village bell rings at midnight, the Court's collectors will open the passage and take custody."
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.1.quest_book.pages.2",
            "fallback": "First payment: Harl Fen, condemned for murdering the miller's son.\nSecond: Mara Voss, raider captured at the east field.\nBoth deliveries were witnessed by Edran Vale and Tomas Reed."
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.1.quest_book.pages.3",
            "fallback": "Fifth payment: an unknown traveler found sleeping in the hayloft. No charge was proven. The council voted four to three that breaking the agreement would endanger forty-seven villagers."
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.1.quest_book.pages.4",
            "fallback": "Ninth payment: Selka, called a thief. Her pack contained bread and a child's wooden horse. Tomas objected. We rang the bell before he could warn her."
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.1.quest_book.pages.5",
            "fallback": "After the twelfth winter, we refused another delivery. Brakka's piglins agreed to hide the waystone in their bastion. We buried this ledger below the ancient city and told our children the ward was a blessing."
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.1.quest_book.pages.6",
            "fallback": "The agreement remains recorded in the Hall Beneath the Eye. Destroying the collectors does not end it. The village representative must renounce it before Avar Khel—or kill him and break the ward by force."
          }
        ]
      },
