      "say": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.5.say",
        "fallback": "Orr Veyl's iron record names the Hall Beneath the Eye and confirms that Avar Khel still holds the prisoners taken through the waystone."
      }
    }
  ],
