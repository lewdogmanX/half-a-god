      "offer_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.offer_line",
        "fallback": "The collectors are gone. Orr Veyl, keeper of the delivery records, has come for the village ledger."
      },
      "target_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.target_line",
        "fallback": "Put down the ledger. Your village survived because twelve prisoners crossed that road. Truth will not make their bargain less useful."
      },
      "talk": [
        [
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.talk.0.0",
            "fallback": "Are any of the prisoners still alive?"
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.talk.0.1",
            "fallback": "Five. The Court does not waste useful hands. They work beneath the Hall and remember exactly who delivered them."
          }
        ],
        [
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.talk.1.0",
            "fallback": "Why keep a second record?"
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.talk.1.1",
            "fallback": "Because your founders lied even to one another. My iron book records the prisoners, the payments, and the location where the agreement can be revoked."
          }
        ],
        [
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.talk.2.0",
            "fallback": "Give me the iron record."
          },
          {
            "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.talk.2.1",
            "fallback": "Take it, and Avar Khel will know I failed. Kill me, and you take it from my corpse. Either road ends my service."
          }
        ]
      ],
      "attack_choice_label": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.attack_choice_label",
        "fallback": "Then die serving him."
      },
      "spare_choice_label": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.spare_choice_label",
        "fallback": "Surrender the record and leave."
      },
      "attack_return_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.attack_return_line",
        "fallback": "Orr Veyl reaches for his sword. The iron record hangs from his belt."
      },
      "spared_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.spared_line",
        "fallback": "Orr Veyl unchains the iron record and places it beside the village ledger."
      },
      "post_spare_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.post_spare_line",
        "fallback": "The Hall Beneath the Eye lies beyond the old Nether fortress gate. Five prisoners remain. If you intend to judge Avar Khel, do it before he moves them."
      },
      "villager_spared_line": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.threats.4.villager_spared_line",
        "fallback": "You let the archivist go, but brought both records. That is evidence enough—and perhaps one less servant for Avar Khel."
      },
