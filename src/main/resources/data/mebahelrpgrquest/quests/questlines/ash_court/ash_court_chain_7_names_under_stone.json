        "fallback": "Orr Veyl, Keeper of Deliveries"
      },
      "stage": 3,
      "say": {
        "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.goals.4.say",
        "fallback": "Orr Veyl admits that five prisoners remain alive and that his iron record identifies the Hall Beneath the Eye."
      }
    },
    {
      "id": "kill_court_archivist",
      "kill": "minecraft:wither_skeleton",
      "amount": 1,
      "attack_only": true,
      "from_threats": true,
