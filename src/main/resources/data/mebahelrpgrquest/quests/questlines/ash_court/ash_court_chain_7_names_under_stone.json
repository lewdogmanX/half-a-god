{
  "title": {
    "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.title",
    "fallback": "Names Under Stone"
  },
  "summary": {
    "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.summary",
    "fallback": "Descend into an ancient city, recover the founders' ledger, and survive the Ash Court's attempt to erase its last witness."
  },
  "flow": {
    "next": "mebahelrpgrquest:ash_court_chain_8_the_last_debt"
  },
  "requires": {
    "quests": [
      "mebahelrpgrquest:ash_court_chain_6_the_court_answers"
    ],
    "traits": [
      "ash_court_answered"
    ]
  },
  "sequential_objectives": true,
  "dialogue": {
    "intro": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.intro",
      "fallback": "The resonator cracked when the Court's second wave died. Inside the fracture is the same route carved into the black-glass waystone you recovered from the bastion. One end lies beneath the village bell. The other lies below an ancient city."
    },
    "offer": [
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.offer.0.0",
          "fallback": "What is the black-glass stone?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.offer.0.1",
          "fallback": "A waystone. The Court's collectors used it to open a short passage between the village road and the Nether. The founders hid it in a bastion when they stopped paying."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.offer.1.0",
          "fallback": "Then what did we defeat at the bell?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.offer.1.1",
          "fallback": "Collectors and soldiers sent through that passage. We broke the route at the bell, but we still do not know what the founders promised them—or what happened to the people they collected."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.offer.2.0",
          "fallback": "Why would the records be in an ancient city?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.offer.2.1",
          "fallback": "The first bell-keeper buried them where thieves would fear to search and where the Wardens would kill anyone sent to recover them. The resonator is following the waystone's old route to that archive."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.offer.3.0",
          "fallback": "What happens when I take it?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.offer.3.1",
          "fallback": "The waystone has already contaminated the archive. Look for netherrack and blackstone cutting through the deepslate. When you open the ledger, the surviving collectors will know."
        }
      ]
    ],
    "return": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.return",
      "fallback": "The bell attacks were not random. The Court came to reopen a collection route our founders used for twelve winters."
    },
    "return_steps": [
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.return_steps.0.0",
          "fallback": "What exactly is written in it?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.return_steps.0.1",
          "fallback": "A winter plague killed thirty-one villagers. Avar Khel supplied medicine, undead sentries, and a ward around the bell."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.return_steps.1.0",
          "fallback": "What did the village pay?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.return_steps.1.1",
          "fallback": "One living prisoner every winter. It began with a murderer and a captured raider. By the ninth payment, the council was abducting travelers whose only crime was having nobody nearby to defend them."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.return_steps.2.0",
          "fallback": "And the black-glass waystone?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.return_steps.2.1",
          "fallback": "It opened the collection passage when the bell rang at midnight. The founders paid piglins to hide it after they stopped the deliveries."
        }
      ],
      [
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.return_steps.3.0",
          "fallback": "What did killing the envoys accomplish?"
        },
        {
          "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.return_steps.3.1",
          "fallback": "It closed the collection passage and proved the Court could bleed. The ledger tells us where the agreement is kept and that some of the prisoners may still be held there."
        }
      ]
    ],
    "reward": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.reward",
      "fallback": "Give me the founders' ledger and Orr Veyl's iron record. Both will be sealed beneath the bell until we confront Avar Khel. Take this compass; it was found beside Selka's wooden horse in the archive."
    },
    "done": {
      "translate": "quest.mebahelrpgrquest.ash_court_chain_7_names_under_stone.dialogue.done",
      "fallback": "The ledger remains open on the ninth payment. Nobody in the village has yet volunteered to read Selka's entry aloud."
    }
  },
  "goals": [
    {
      "id": "reach_buried_archive",
      "reach": "minecraft:ancient_city",
      "radius": 15000,
      "range": 96,
      "auto_advance": true,
